<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Dark Theme Color Palette ── -->
    
    <!-- Backgrounds -->
    <Color x:Key="WindowBackgroundColor">#1A1A1F</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1A1F"/>

    <Color x:Key="SurfaceColor">#25252B</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#25252B"/>

    <Color x:Key="SurfaceLightColor">#2D2D35</Color>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#2D2D35"/>

    <Color x:Key="SurfaceHoverColor">#383842</Color>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#383842"/>

    <Color x:Key="SurfaceSelectedColor">#1E3A8A</Color>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#1E3A8A" Opacity="0.3"/>

    <Color x:Key="WindowHeaderColor">#2D2D35</Color>
    <SolidColorBrush x:Key="WindowHeaderBrush" Color="#2D2D35"/>

    <!-- Accents -->
    <Color x:Key="AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>

    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>

    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <Color x:Key="SuccessColor">#10B981</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

    <Color x:Key="ErrorColor">#EF4444</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F9FAFB</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB"/>

    <Color x:Key="TextSecondaryColor">#D1D5DB</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D1D5DB"/>

    <Color x:Key="TextMutedColor">#9CA3AF</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF"/>

    <!-- Borders -->
    <Color x:Key="BorderColor">#2D2D35</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#2D2D35"/>

    <Color x:Key="BorderLightColor">#3F3F4A</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#3F3F4A"/>

</ResourceDictionary>
