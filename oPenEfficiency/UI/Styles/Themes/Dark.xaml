<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Dark Theme Color Palette ── -->
    
    <!-- Backgrounds -->
    <Color x:Key="WindowBackgroundColor">#1A1A1F</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1A1F"/>

    <!-- PowerPoint task-pane/sidebar background. Keep separate from openEfficiency windows. -->
    <Color x:Key="SidebarBackgroundColor">#292929</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#292929"/>

    <Color x:Key="SidebarSectionHeaderColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SidebarSectionHeaderBrush" Color="#FFFFFF"/>

    <Color x:Key="SidebarDividerColor">#656565</Color>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#656565"/>

    <Color x:Key="SurfaceColor">#25252B</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#25252B"/>

    <Color x:Key="SurfaceLightColor">#2D2D35</Color>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#2D2D35"/>

    <Color x:Key="SurfaceHoverColor">#383842</Color>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#383842"/>

    <Color x:Key="SurfaceSelectedColor">#1E3A8A</Color>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#1E3A8A" Opacity="0.3"/>

    <Color x:Key="IconPreviewBackgroundColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="IconPreviewBackgroundBrush" Color="#F8FAFC"/>

    <Color x:Key="IconPreviewBorderColor">#CBD5E1</Color>
    <SolidColorBrush x:Key="IconPreviewBorderBrush" Color="#CBD5E1"/>

    <Color x:Key="WindowHeaderColor">#2D2D35</Color>
    <SolidColorBrush x:Key="WindowHeaderBrush" Color="#2D2D35"/>

    <!-- Accents -->
    <Color x:Key="AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>

    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>

    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <Color x:Key="SuccessColor">#10B981</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

    <Color x:Key="ErrorColor">#EF4444</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F9FAFB</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB"/>

    <Color x:Key="TextSecondaryColor">#D1D5DB</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D1D5DB"/>

    <Color x:Key="TextMutedColor">#9CA3AF</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF"/>

    <!-- Office Icon foreground (Fluent colorNeutralForeground2 dark) -->
    <Color x:Key="OfficeIconForegroundColor">#D6D6D6</Color>
    <SolidColorBrush x:Key="OfficeIconForegroundBrush" Color="#D6D6D6"/>

    <Color x:Key="OfficeIconDisabledColor">#525252</Color>
    <SolidColorBrush x:Key="OfficeIconDisabledBrush" Color="#525252"/>

    <!-- Semantic accent roles for two-layer icon model -->
    <Color x:Key="AccentBlueColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>

    <Color x:Key="AccentGreenColor">#10B981</Color>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981"/>

    <Color x:Key="SuccessGreenColor">#10B981</Color>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981"/>

    <Color x:Key="AccentYellowColor">#F59E0B</Color>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#F59E0B"/>

    <Color x:Key="AccentRedColor">#EF4444</Color>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444"/>

    <!-- Borders -->
    <Color x:Key="BorderColor">#2D2D35</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#2D2D35"/>

    <Color x:Key="BorderLightColor">#3F3F4A</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#3F3F4A"/>

    <!-- Elevation -->
    <Color x:Key="ShadowColor">#000000</Color>

</ResourceDictionary>
