<Window x:Class="oPenEfficiency.UI.ImportAgendaLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Agenda Layouts"
        Width="600" SizeToContent="Height" KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style><StaticResource ResourceKey="CompactTaskWindowStyle"/></Window.Style>
    <Border Style="{StaticResource CompactTaskShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MinHeight="{StaticResource ModalHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="IMPORT AGENDA LAYOUTS" Style="{StaticResource DialogTitleText}" TextWrapping="Wrap" Margin="{StaticResource SpaceNone}"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Close (Esc)" AutomationProperties.Name="Close Agenda Layout Import"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="0,0,10,0">
                    <!-- Import from file -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Import from XML File" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Select an AgendaCreator.xml file from other PowerPoint tools"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="{StaticResource SectionGapCompact}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtXmlPath" AutomationProperties.Name="Agenda layout XML file" Grid.Column="0" Height="32" Style="{StaticResource CompactTextBox}"/>

                                <Button Grid.Column="1" Content="Browse..." Width="80" Height="32" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="BtnBrowseFile_Click"/>

                                <Button Grid.Column="2" Content="Import" Width="80" Height="32" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" Click="BtnImportFile_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Import from folder -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Import from Folder" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Scan a folder for all AgendaCreator.xml files (including subfolders)"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="{StaticResource SectionGapCompact}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtFolderPath" AutomationProperties.Name="Agenda layout folder" Grid.Column="0" Height="32" Style="{StaticResource CompactTextBox}"/>

                                <Button Grid.Column="1" Content="Browse..." Width="80" Height="32" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="BtnBrowseFolder_Click"/>

                                <Button Grid.Column="2" Content="Import All" Width="100" Height="32" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" Click="BtnImportFolder_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Auto-detect -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Auto-Detect" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Automatically find and import AgendaCreator.xml files from other tools"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="{StaticResource SectionGapCompact}"/>

                            <Button x:Name="BtnAutoDetect" Content="Search and Import" Width="160" Height="32" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}" Click="BtnAutoDetect_Click"/>

                            <TextBlock x:Name="TxtAutoDetectStatus" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Border x:Name="ResultBorder" Style="{StaticResource StatusBanner}" BorderBrush="{DynamicResource SuccessBrush}" Margin="{StaticResource SectionGapCompact}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtResultHeading" Text="Import Results" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtResult" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource SectionGapCompactTop}">
                <Button Content="Close" Width="100" Height="32" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
