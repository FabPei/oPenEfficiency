<UserControl x:Class="oPenEfficiency.UI.Controls.FeatureIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:oPenEfficiency.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="24">
    <Viewbox x:Name="IconViewbox" Stretch="Uniform">
        <!-- IsHitTestVisible=False keeps the glyph purely decorative as defense in depth: only a
             FeatureId change rebuilds these children (PQ-016), but input must always hit the
             stable button template, never transient icon visuals. -->
        <Grid x:Name="IconLayerHost" Width="24" Height="24" IsHitTestVisible="False"/>
    </Viewbox>
</UserControl>
