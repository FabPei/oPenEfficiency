<UserControl x:Class="oPenEfficiency.UI.SizeAdjustControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto" Background="Transparent">
    <Grid Margin="0,4,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>

        <!-- Width Row -->
        <Viewbox Grid.Row="0" Grid.Column="0" Margin="0,4,6,4">
            <Path Fill="{DynamicResource TextMutedBrush}" Data="M2,10 L10,10 L10,6 L22,6 L22,14 L10,14 L10,10 L2,10 M6,4 L4,6 L6,8 M6,12 L4,14 L6,16 M18,4 L20,6 L18,8 M18,12 L20,14 L18,16"/>
        </Viewbox>
        <Border Grid.Row="0" Grid.Column="1" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True" Margin="6,0">
                <TextBlock Text="cm" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtWidth"   
                         VerticalContentAlignment="Center" FontSize="13" />
            </DockPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Margin="2,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Click="BtnWidthUp_Click" ToolTip="Increase width"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Viewbox>
                        <Path Fill="{DynamicResource AccentBrush}" Data="M7,15H17V13H7V15M12,8L17,13H7L12,8Z"/>
                    </Viewbox>
                </Button>
                <Button Grid.Row="1" Click="BtnWidthDown_Click" ToolTip="Decrease width"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Viewbox>
                        <Path Fill="{DynamicResource AccentBrush}" Data="M7,9H17V11H7V9M12,16L7,11H17L12,16Z"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- Height Row -->
        <Viewbox Grid.Row="1" Grid.Column="0" Margin="0,4,6,4">
            <Path Fill="{DynamicResource TextMutedBrush}" Data="M10,2 L10,10 L6,10 L6,22 L14,22 L14,10 L10,10 L10,2 M4,6 L6,4 L8,6 M12,6 L14,4 L16,6 M4,18 L6,20 L8,18 M12,18 L14,20 L16,18"/>
        </Viewbox>
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True" Margin="6,0">
                <TextBlock Text="cm" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtHeight"   
                         VerticalContentAlignment="Center" FontSize="13" />
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Margin="2,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Click="BtnHeightUp_Click" ToolTip="Increase height"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Viewbox>
                        <Path Fill="{DynamicResource AccentBrush}" Data="M7,15H17V13H7V15M12,8L17,13H7L12,8Z"/>
                    </Viewbox>
                </Button>
                <Button Grid.Row="1" Click="BtnHeightDown_Click" ToolTip="Decrease height"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Viewbox>
                        <Path Fill="{DynamicResource AccentBrush}" Data="M7,9H17V11H7V9M12,16L7,11H17L12,16Z"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
