<Window x:Class="oPenEfficiency.UI.ThermometerAdorner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermometer Control" 
        Height="48" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated">

    <Window.Resources>
                <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Color Palette -->
        <Color x:Key="GlassWhite">#F0FFFFFF</Color>
        <SolidColorBrush x:Key="GlassWhiteBrush" Color="{StaticResource GlassWhite}"/>
        <Color x:Key="DeepCharcoal">#202124</Color>
        <SolidColorBrush x:Key="CharcoalBrush" Color="{StaticResource DeepCharcoal}"/>

        <!-- Minimal Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#E0E0E0" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#CCCCCC" StrokeThickness="1">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch style -->
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button" xmlns:s="clr-namespace:System.Windows.Shapes;assembly=PresentationFramework">
                        <Grid>
                            <Ellipse x:Name="border" Fill="{TemplateBinding Background}" Stroke="#E0E0E0" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Stroke" Value="#888888"/>
                                <Setter TargetName="border" Property="StrokeThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource GlassWhiteBrush}" BorderBrush="#20000000" BorderThickness="1" CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.12" Direction="270"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <!-- Icon/Label -->
            <TextBlock Text="🌡️" VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0"/>

            <!-- Slider 0-100 -->
            <Slider x:Name="SldPercentage" Width="120" Minimum="0" Maximum="100" Value="50" 
                    Style="{StaticResource ModernSlider}" VerticalAlignment="Center"
                    ValueChanged="SldPercentage_ValueChanged"/>
            
            <!-- Percentage Display -->
            <Border Background="#10000000" CornerRadius="6" Margin="12,0" Padding="8,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtValue" Text="50" BorderThickness="0" Background="Transparent" 
                             Width="28" FontSize="13" TextAlignment="Center" FontWeight="SemiBold"
                             TextChanged="TxtValue_TextChanged"/>
                    <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="#20000000" Margin="4,0,12,0"/>

            <!-- Color Selection Button -->
            <Button x:Name="BtnColorWell" Style="{StaticResource ColorSwatch}" Background="#E83232" Click="BtnColorWell_Click"/>
            
            <!-- Color Popup -->
            <Popup x:Name="ColorPopup" StaysOpen="False" Placement="Top" HorizontalOffset="-50" VerticalOffset="-4" PlacementTarget="{Binding ElementName=BtnColorWell}">
                <Border Background="White" CornerRadius="12" Padding="8" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" Opacity="0.1" BlurRadius="12" ShadowDepth="2"/>
                    </Border.Effect>
                    <WrapPanel x:Name="ColorPalette" Width="104"/>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</Window>
