<Window x:Class="oPenEfficiency.UI.ExcelLinkManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Link Manager" Width="1060" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="EXCEL LINK MANAGER" Style="{StaticResource DialogTitleText}"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <DataGrid x:Name="LinksGrid" Grid.Row="1" Margin="0,15,0,0" ItemsSource="{Binding Links}" AutoGenerateColumns="False"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF" Foreground="{DynamicResource TextPrimaryBrush}"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                      SelectionChanged="LinksGrid_SelectionChanged" MouseDoubleClick="LinksGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          PreviewMouseLeftButtonDown="LinkSelectionCheckBox_PreviewMouseLeftButtonDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Slide" Binding="{Binding SlideNumber}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Shape" Binding="{Binding ShapeName}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Last refresh" Binding="{Binding LastRefresh}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Go to" Click="GoTo_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                    <Button Content="Open Source" Click="OpenSource_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                    <Button Content="Relink Source" Click="Relink_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                    <Button Content="Unlink" Click="BreakLink_Click" Style="{StaticResource OutlineButton}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh All" Click="RefreshAll_Click" Style="{StaticResource OutlineButton}" Margin="0,0,10,0"/>
                    <Button Content="Refresh Selected" Click="Refresh_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
