<Window x:Class="oPenEfficiency.UI.Dialogs.IllustrationLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Illustration Library" Height="800" Width="1180" MinHeight="600" MinWidth="940"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{DynamicResource LargeWorkspaceWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{DynamicResource WorkspaceShell}" Padding="{StaticResource SpaceNone}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="{StaticResource RadiusWindowTop}">
                <Grid Margin="20,14,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Illustration Library" Style="{StaticResource DialogTitleText}"/>
                        <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource ContextMetaText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="FiguresViewButton" Content="Figures" Height="28" Padding="14,0" Margin="0,0,8,0"
                                    Click="FiguresViewButton_Click" AutomationProperties.Name="Show illustration figures"/>
                            <Button x:Name="SourcesViewButton" Content="Sources &amp; import" Height="28" Padding="14,0"
                                    Click="SourcesViewButton_Click" AutomationProperties.Name="Show illustration sources"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click"
                            AutomationProperties.Name="Close Illustration Library" VerticalAlignment="Top" Margin="0,-4,-4,0"/>
                </Grid>
            </Border>

            <Grid x:Name="FiguresView" Grid.Row="1" Margin="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FigureSearchBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                                 TextChanged="FigureSearchBox_TextChanged" KeyDown="FigureSearchBox_KeyDown"
                                 AutomationProperties.Name="Search illustrations"
                                 ToolTip="Type to filter. Press Enter to move to the results."/>
                        <ComboBox x:Name="CollectionFilterBox" Grid.Column="1" Width="220" Height="30" Margin="8,0,0,0"
                                  SelectionChanged="CollectionFilterBox_SelectionChanged" AutomationProperties.Name="Filter by collection"/>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="FigureList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="FigureList_SelectionChanged"
                             KeyDown="FigureList_KeyDown" MouseDoubleClick="FigureList_MouseDoubleClick"
                             AutomationProperties.Name="Illustration search results">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="56" Height="56" Background="{DynamicResource SurfaceLightBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSmall}" Padding="4">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   AutomationProperties.Name="{Binding Name}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DetailLine}" Style="{StaticResource ContextMetaText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="FigureName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="FigureMeta" Style="{StaticResource ContextMetaText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FigureLicense" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Text="Colours" FontWeight="SemiBold" Margin="0,14,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel x:Name="PalettePanel"/>

                            <TextBlock Text="Parts" FontWeight="SemiBold" Margin="0,14,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="PartsHint" Style="{StaticResource ContextMetaText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <StackPanel x:Name="PartsPanel"/>

                            <TextBlock Text="Insert" FontWeight="SemiBold" Margin="0,14,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox x:Name="InsertModeBox" Height="30" AutomationProperties.Name="Insert mode">
                                <ComboBoxItem Content="SVG picture (scalable)"/>
                                <ComboBoxItem Content="Editable shapes (converted)"/>
                            </ComboBox>
                            <ComboBox x:Name="InsertSizeBox" Height="30" Margin="0,8,0,0" AutomationProperties.Name="Insert size">
                                <ComboBoxItem Content="Small (160 pt)"/>
                                <ComboBoxItem Content="Medium (240 pt)"/>
                                <ComboBoxItem Content="Large (360 pt)"/>
                            </ComboBox>
                            <Button x:Name="InsertButton" Style="{StaticResource PrimaryButton}" Content="Insert into slide"
                                    Height="34" Margin="0,10,0,0" Click="InsertButton_Click"
                                    AutomationProperties.Name="Insert illustration into slide"/>
                            <TextBlock Text="Keyboard: Ctrl+F searches; Enter on a result inserts it."
                                       Style="{StaticResource ContextMetaText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InsertFeedback" Style="{StaticResource ContextMetaText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="SourcesView" Grid.Row="1" Margin="20,16,20,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Sources" FontWeight="SemiBold" Margin="2,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ListBox Grid.Row="1" x:Name="SourceList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SourceList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource ContextMetaText}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding LicenseSummary}" Style="{StaticResource ContextMetaText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DetailName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DetailStatus" Style="{StaticResource ContextMetaText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailLicense" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DetailAttribution" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailAcquisition" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailTechnical" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="OpenSiteButton" Style="{StaticResource SecondaryButton}" Content="Open website"
                                        Height="30" Padding="12,0" Margin="0,0,8,0" Click="OpenSiteButton_Click"
                                        AutomationProperties.Name="Open source website"/>
                                <Button x:Name="OpenLicenseButton" Style="{StaticResource SecondaryButton}" Content="Open license"
                                        Height="30" Padding="12,0" Click="OpenLicenseButton_Click"
                                        AutomationProperties.Name="Open source license page"/>
                            </StackPanel>

                            <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Import SVG files..."
                                    Height="34" Margin="0,12,0,0" Click="ImportButton_Click"
                                    AutomationProperties.Name="Import SVG files"/>
                            <TextBlock x:Name="ImportHint" Style="{StaticResource ContextMetaText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="20,14,20,16">
                <Border x:Name="NoticePanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Your responsibility" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="NoticeText" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open import folder"
                            Height="30" Padding="12,0" Margin="0,0,8,0" Click="OpenFolderButton_Click"
                            AutomationProperties.Name="Open import folder"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Close"
                            Height="30" Padding="18,0" Click="BtnClose_Click"
                            AutomationProperties.Name="Close Illustration Library"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
