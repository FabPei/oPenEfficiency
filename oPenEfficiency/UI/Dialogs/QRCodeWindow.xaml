<Window x:Class="oPenEfficiency.UI.QRCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate QR Code" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style><StaticResource ResourceKey="CompactTaskWindowStyle"/></Window.Style>
    <Border Style="{StaticResource CompactTaskShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MinHeight="{StaticResource ModalHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                    <TextBlock Text="GENERATE QR CODE" Style="{StaticResource DialogTitleText}" TextWrapping="Wrap" Margin="{StaticResource SpaceNone}"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="BtnCancel_Click"
                        ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel QR code generation"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="{StaticResource RelatedControlGap}">
                    <TextBlock Text="Target URL or text" Style="{StaticResource ContextMetaText}" Margin="{StaticResource RelatedControlGap}"/>
                    <TextBox x:Name="TxtUrl" Style="{StaticResource CompactTextBox}" KeyDown="TxtUrl_KeyDown"
                             HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="QR code URL or text"/>
                </StackPanel>
            </ScrollViewer>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="{StaticResource Space4}">
                <Button x:Name="BtnOk" Content="Generate &amp; Insert" Style="{StaticResource PrimaryButton}" Click="BtnOk_Click" Margin="{StaticResource Space2}"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="{StaticResource Space2}"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
