<Window x:Class="oPenEfficiency.UI.Dialogs.FeatureExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:oPenEfficiency.UI.Controls"
        Title="Feature Explorer" Height="640" Width="1040" MinHeight="480" MinWidth="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{DynamicResource LargeWorkspaceWindowStyle}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="WindowChromeControl"
                      CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="CategoryToggleStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{StaticResource TypographyBodySize}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <EventSetter Event="GotKeyboardFocus" Handler="Category_GotKeyboardFocus"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FeatureCardStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Margin" Value="{StaticResource Space6}"/>
                <Setter Property="Padding" Value="{StaticResource Space8}"/>
                <Setter Property="Width" Value="220"/>
                <Setter Property="MinHeight" Value="78"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="{Binding Name}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusLarge}" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource SurfaceLightBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Margin="0,0,6,0">
                                            <controls:FeatureIcon FeatureId="{Binding Id}" IconColor="{Binding IconColor}" ColorMode="{Binding IconColorMode}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" MinWidth="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource TypographyBodySize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Golden Reference: Large Workspace. -->
    <Border Style="{DynamicResource WorkspaceShell}" Padding="{StaticResource SpaceNone}">
        <Grid Margin="{StaticResource SpaceNone}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header & Filters -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource RadiusWindowTop}">
                <Grid Margin="{StaticResource StandardOuterPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid x:Name="HeaderDragRegion" Height="{StaticResource WorkspaceHeaderHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="FEATURE EXPLORER" Style="{StaticResource DialogTitleText}"
                                   FontSize="{StaticResource TypographyWindowTitleSize}"/>
                        
                        <!-- Search Bar -->
                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SearchBoxContainer}">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" AutomationProperties.Name="Search commands" Margin="24,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock IsHitTestVisible="False" Text="Search commands..." VerticalAlignment="Center" Margin="26,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource TypographyBodySize}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" AutomationProperties.Name="Close Feature Explorer" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </Grid>

                    <!-- Categories use compact integrated overflow controls; the scrollbar chrome stays hidden. -->
                    <Grid x:Name="CategoryNavigationHost" Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CategoryScrollLeftButton" Grid.Column="0" Style="{DynamicResource CompactIconButton}"
                                Margin="0,0,4,0" Click="CategoryScrollLeftButton_Click"
                                ToolTip="Show earlier categories" AutomationProperties.Name="Show earlier categories"
                                Visibility="Collapsed">
                            <Path IsHitTestVisible="False" Data="M14,5 L7,12 L14,19" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <ScrollViewer x:Name="CategoryScrollViewer" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      Loaded="CategoryScrollViewer_Loaded" SizeChanged="CategoryScrollViewer_SizeChanged"
                                      ScrollChanged="CategoryScrollViewer_ScrollChanged">
                            <StackPanel x:Name="CategoryFilters" Orientation="Horizontal">
                                <RadioButton Content="All" Tag="All" Style="{StaticResource CategoryToggleStyle}" IsChecked="True" Checked="Category_Checked"/>
                                <RadioButton Content="Align &amp; Size" Tag="Align &amp; Size" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Arrange &amp; Organize" Tag="Arrange &amp; Organize" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Text &amp; Format" Tag="Text &amp; Format" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Tables" Tag="Tables" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Visual Elements" Tag="Visual Elements" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Storyline &amp; Review" Tag="Storyline &amp; Review" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Data &amp; Automation" Tag="Data &amp; Automation" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Libraries" Tag="Libraries" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Settings &amp; Help" Tag="Settings &amp; Help" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                                <RadioButton Content="Labs" Tag="Labs" Style="{StaticResource CategoryToggleStyle}" Checked="Category_Checked"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="CategoryScrollRightButton" Grid.Column="2" Style="{DynamicResource CompactIconButton}"
                                Margin="4,0,0,0" Click="CategoryScrollRightButton_Click"
                                ToolTip="Show later categories" AutomationProperties.Name="Show later categories"
                                Visibility="Collapsed">
                            <Path IsHitTestVisible="False" Data="M10,5 L17,12 L10,19" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="DetailsColumn" Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- The ListBox owns the card pane's single vertical scroll surface. -->
                <ListBox x:Name="FeatureList" ItemsSource="{Binding DisplayedFeatures}" AutomationProperties.Name="Available commands"
                         Background="Transparent" BorderThickness="0" Margin="10,12,0,12"
                         SelectionChanged="FeatureList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource FeatureCardStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Rectangle x:Name="DetailsDivider" Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                <!-- Details Sidebar -->
                <Border x:Name="DetailsRegion" Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="{StaticResource RadiusWindowBottomRight}" Padding="{StaticResource StandardOuterPadding}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                            
                            <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <controls:FeatureIcon x:Name="DetailIcon" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="DetailName" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                            <TextBlock x:Name="DetailMaturity" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,-8,0,15" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailDescription" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,25" LineHeight="22"/>

                            <Border x:Name="DetailImageBorder" CornerRadius="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="4" Margin="0,0,0,25" Visibility="Collapsed">
                                <Image x:Name="DetailImage" Stretch="Uniform" MaxHeight="200" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="How to use it" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DetailDetailedHelp" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,25" LineHeight="22"/>

                            <Grid x:Name="ShortcutPanel" Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Shortcut" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                    <TextBlock x:Name="DetailShortcut" FontSize="15" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
