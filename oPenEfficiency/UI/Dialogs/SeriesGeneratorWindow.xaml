<Window x:Class="oPenEfficiency.UI.Dialogs.SeriesGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Series Generator" Height="680" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseDown="Window_MouseDown"
        FontFamily="Segoe UI Variable Small, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Border" x:Key="SettingCard">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="SERIES GENERATOR" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="Generate sequences of text or numbers." Margin="0,4,0,0" Style="{StaticResource DialogSubtitleText}"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Click="BtnCancel_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Configuration Left -->
                    <Border Grid.Column="0" Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="SERIES SETTINGS" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Text="Series Type" Margin="0,0,0,5" />
                            <ComboBox x:Name="CmbSeriesType" Margin="0,0,0,15" SelectionChanged="CmbSeriesType_SelectionChanged">
                                <ComboBoxItem Content="Numbers" Tag="Numbers" IsSelected="True" />
                                <ComboBoxItem Content="Letters (A-Z)" Tag="Letters" />
                                <ComboBoxItem Content="Days" Tag="Days" />
                                <ComboBoxItem Content="Months" Tag="Months" />
                                <ComboBoxItem Content="Quarters" Tag="Quarters" />
                                <ComboBoxItem Content="Years" Tag="Years" />
                            </ComboBox>

                            <StackPanel x:Name="PanelLanguage" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Language (for Dates)" Margin="0,0,0,5" />
                                <ComboBox x:Name="CmbLanguage" SelectionChanged="CmbLanguage_SelectionChanged" DisplayMemberPath="DisplayName" SelectedValuePath="Name" />
                            </StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start Value" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtStartValue" Text="1" TextChanged="UpdatePreview" Style="{StaticResource InlineTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="End Value" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtEndValue" ToolTip="Leave empty to use Count" TextChanged="UpdatePreview" Style="{StaticResource InlineTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Count (Max items)" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtCount" Text="5" TextChanged="UpdatePreview" Style="{StaticResource InlineTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Step / Skip" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtStep" Text="1" TextChanged="UpdatePreview" Style="{StaticResource InlineTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Formatting Preset" Margin="0,0,0,5" />
                            <ComboBox x:Name="CmbFormatPresets" Margin="0,0,0,15" SelectionChanged="CmbFormatPresets_SelectionChanged" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Custom Format" />
                                <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Dates: 'MMM yy' → Jan 24, 'yyyy-MM-dd' → 2024-01-01&#x0a;Numbers: '000' → 001, 'Step {0}' → Step 1" />
                            </StackPanel>
                            <TextBox x:Name="TxtFormat" Text="0" Margin="0,0,0,15" TextChanged="UpdatePreview" Style="{StaticResource InlineTextBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Layout Right -->
                    <Border Grid.Column="2" Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="LAYOUT SETTINGS" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Text="Direction" Margin="0,0,0,5" />
                            <ComboBox x:Name="CmbDirection" Margin="0,0,0,15" SelectionChanged="CmbDirection_SelectionChanged">
                                <ComboBoxItem Content="Horizontal (Left to Right)" Tag="Horizontal" IsSelected="True" />
                                <ComboBoxItem Content="Vertical (Top to Bottom)" Tag="Vertical" />
                                <ComboBoxItem Content="Matrix (Grid)" Tag="Matrix" />
                            </ComboBox>

                            <StackPanel x:Name="PanelMatrixCols" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Columns" Margin="0,0,0,5" />
                                <TextBox x:Name="TxtMatrixColumns" Text="3" Style="{StaticResource InlineTextBoxStyle}" />
                            </StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Spacing X (pt)" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtSpacingX" Text="15" Style="{StaticResource InlineTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Spacing Y (pt)" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtSpacingY" Text="15" Style="{StaticResource InlineTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Boundaries Section -->
                            <TextBlock Text="BOUNDARIES &amp; AUTO-FIT" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <CheckBox x:Name="ChkAutoFit" Content="Auto-fit to bounds (Reduce size &amp; spacing)" IsChecked="True" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="CmbBoundaryType" Margin="0,0,0,5" SelectionChanged="CmbBoundaryType_SelectionChanged">
                                <ComboBoxItem Content="Slide Boundaries" Tag="Slide" IsSelected="True" />
                                <ComboBoxItem Content="Selected Shape Boundaries" Tag="SelectedShape" />
                            </ComboBox>
                            <TextBlock x:Name="TxtBoundaryWarning" Text="Select 2 shapes: Shape 1 = Template, Shape 2 = Boundary." FontSize="10" Foreground="OrangeRed" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Live Preview Block -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="LIVE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtPreview" Text="..." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancel" Width="80" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
                <Button x:Name="BtnGenerate" Content="Generate Series" Width="120" Style="{StaticResource AccentButton}" Click="BtnGenerate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>