<Window x:Class="oPenEfficiency.UI.TransparentColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magic Color Erase" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown">
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Border" x:Key="SettingCard">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>

            

            
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="MAGIC COLOR ERASE" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="Remove specific colors using tolerance." Style="{StaticResource DialogSubtitleText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" />
            </Grid>

            <TextBlock Text="Pick a color to erase:" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,8"/>
            
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ColorPreview" Width="32" Height="32" Background="#FFFFFF" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="Pick Color" Click="BtnPickColor_Click" Style="{StaticResource AccentButton}" Height="32"/>
            </Grid>

            <TextBlock Text="Tolerance (0-100)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="100" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Grid.Column="0"/>
                <TextBlock Text="{Binding ElementName=ToleranceSlider, Path=Value}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1"/>
            </Grid>

            <Button Content="ERASE COLOR" Click="BtnApply_Click" Style="{StaticResource AccentButton}" Height="36" FontWeight="Bold"/>
            
            <TextBlock Text="Note: This works best on solid colors. Complex gradients might leave artifacts." Foreground="#666" FontSize="10" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
