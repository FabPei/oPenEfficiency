<Window x:Class="oPenEfficiency.UI.ArrangeGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange in Grid" MinWidth="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{DynamicResource CompactTaskWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Topmost="False"
        PreviewKeyDown="Window_PreviewKeyDown">
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Golden Reference: Compact Task Window, modeless lifecycle variant. -->
    <Border Style="{DynamicResource CompactTaskShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content area with some flex -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="{StaticResource ModalHeaderHeight}" Margin="{StaticResource SectionGapCompact}"
                  MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                <TextBlock Text="ARRANGE IN GRID" Style="{StaticResource DialogTitleText}"/>
                <Button Style="{StaticResource WindowCloseButton}" Click="BtnCancel_Click"
                        AutomationProperties.Name="Close Arrange Grid"/>
            </Grid>

            <!-- Inputs Area (Grid in Row 1) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columns Input Group -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Columns" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="{StaticResource RelatedControlGap}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource NumericStepButton}" Click="BtnDecCols_Click" AutomationProperties.Name="Decrease columns"/>
                        <TextBox Style="{StaticResource CompactTextBox}" x:Name="TxtColumns" Width="42" Margin="6,0" Text="3" PreviewTextInput="NumberValidationTextBox" TextChanged="Input_TextChanged" HorizontalContentAlignment="Center" AutomationProperties.Name="Columns"/>
                        <Button Content="+" Style="{StaticResource NumericStepButton}" Click="BtnIncCols_Click" AutomationProperties.Name="Increase columns"/>
                    </StackPanel>
                </StackPanel>

                <!-- Rows Input Group -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Rows" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="{StaticResource RelatedControlGap}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource NumericStepButton}" Click="BtnDecRows_Click" AutomationProperties.Name="Decrease rows"/>
                        <TextBox Style="{StaticResource CompactTextBox}" x:Name="TxtRows" Width="42" Margin="6,0" Text="3" PreviewTextInput="NumberValidationTextBox" TextChanged="Input_TextChanged" HorizontalContentAlignment="Center" AutomationProperties.Name="Rows"/>
                        <Button Content="+" Style="{StaticResource NumericStepButton}" Click="BtnIncRows_Click" AutomationProperties.Name="Increase rows"/>
                    </StackPanel>
                </StackPanel>

                <!-- Spacing Input Group -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Spacing" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="{StaticResource RelatedControlGap}" HorizontalAlignment="Center"/>
                    <TextBox Style="{StaticResource CompactTextBox}" x:Name="TxtSpacing" Text="10" Width="74" PreviewTextInput="DecimalValidationTextBox" TextChanged="Input_TextChanged" HorizontalContentAlignment="Center" AutomationProperties.Name="Spacing"/>
                </StackPanel>
            </Grid>

            <!-- Footer: schematic live preview (left) + actions (right) -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border x:Name="PreviewHost" Width="72" Height="48" Padding="3"
                            Background="{DynamicResource SurfaceLightBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1" CornerRadius="4" VerticalAlignment="Center"
                            Focusable="False" AutomationProperties.Name="Grid preview">
                        <UniformGrid x:Name="PreviewCells"/>
                    </Border>
                    <TextBlock x:Name="PreviewDimensionLabel" Text="3 × 3" Margin="8,0,0,0"
                               FontSize="{StaticResource TypographyCaptionSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Grid preview dimensions"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnArrange" Content="Arrange" MinWidth="90" MinHeight="{StaticResource ControlHeightStandard}" Style="{StaticResource PrimaryButton}" Click="BtnArrange_Click" AutomationProperties.Name="Arrange selected shapes"/>
                    <Button Content="Close" MinWidth="90" MinHeight="{StaticResource ControlHeightStandard}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" AutomationProperties.Name="Close without arranging"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
