<Window x:Class="oPenEfficiency.UI.Dialogs.StorylineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storyline Review"
        Height="720" Width="760" MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="STORYLINE REVIEW" Style="{StaticResource DialogTitleText}"/>
                </StackPanel>
                <Button Content="✕" Click="CloseButton_Click" Style="{StaticResource WindowCloseButton}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,8,0" Padding="9,6"
                         TextChanged="Filter_Changed" ToolTip="Search headlines, sections, issues, or framework roles"/>
                <ComboBox x:Name="FilterCombo" Grid.Column="1" Margin="0,0,8,0" Padding="6"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All headlines" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Issues only" Tag="Issues"/>
                    <ComboBoxItem Content="Missing titles" Tag="Missing"/>
                    <ComboBoxItem Content="Needs review" Tag="Review"/>
                    <ComboBoxItem Content="Excluded" Tag="Excluded"/>
                </ComboBox>
                <ComboBox x:Name="ScopeCombo" Grid.Column="2" Margin="0,0,8,0" Padding="6"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Entire presentation" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Current section" Tag="Section"/>
                </ComboBox>
                <CheckBox x:Name="AutoRefreshCheckBox" Grid.Column="3" Content="Auto refresh"
                          IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="Refresh" Click="RefreshButton_Click"
                        Style="{StaticResource SecondaryButton}" Padding="14,6"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource SettingCard}" Padding="0" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,4">
                    <ItemsControl x:Name="TitlesList">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6"
                                                Margin="0,10,0,2" Padding="10,6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="4,10" Background="Transparent"
                                        PreviewMouseLeftButtonDown="Item_Click" Cursor="Hand">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="StorylineItemContextMenu_Opened"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Go to Slide" Click="GoToSlide_Click"/>
                                            <MenuItem Header="Edit Headline" Click="EditMenu_Click"/>
                                            <MenuItem Header="Copy Headline" Click="CopyHeadline_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Apply Suggested Action Title" Click="ApplySuggestion_Click"/>
                                            <MenuItem Header="Copy Suggested Action Title" Click="CopySuggestion_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Set Review Status">
                                                <MenuItem Header="Draft" Click="SetStatus_Click"/>
                                                <MenuItem Header="Needs Input" Click="SetStatus_Click"/>
                                                <MenuItem Header="Review" Click="SetStatus_Click"/>
                                                <MenuItem Header="Final" Click="SetStatus_Click"/>
                                                <MenuItem Header="None" Click="SetStatus_Click"/>
                                            </MenuItem>
                                            <MenuItem Header="Assign to Section" Tag="Sections"/>
                                            <Separator/>
                                            <MenuItem Header="Insert Slide After" Click="InsertSlideAfter_Click"/>
                                            <MenuItem Header="Move Slide Up" Click="MoveSlideUp_Click"/>
                                            <MenuItem Header="Move Slide Down" Click="MoveSlideDown_Click"/>
                                            <MenuItem Header="Hide / Unhide Slide" Click="ToggleHidden_Click"/>
                                            <MenuItem Header="Exclude / Include in Storyline" Click="ToggleExcluded_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Background="{DynamicResource SurfaceLightBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SlideNumber}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Grid Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtRead" Text="{Binding TitleText}" FontSize="13"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           LineHeight="18"/>
                                                <TextBox x:Name="TxtEdit" Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                                                         Padding="5" KeyDown="TxtEdit_KeyDown"
                                                         LostFocus="TxtEdit_LostFocus"/>
                                                <TextBlock Text="{Binding SuggestedTitle, StringFormat=Suggestion: {0}}"
                                                           FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FrameworkRole}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding IssueSummary}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="#DC2626" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Padding="5"
                                                Click="Edit_Click" ToolTip="Edit headline" IsEnabled="{Binding CanEdit}">
                                            <Path Data="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.08L18.92,8.92L20.71,7.13C21.1,6.74 21.1,6.1 20.71,5.71L18.29,2.29C18.1,2.1 17.84,2 17.66,3M14.06,6.19L3,17.25V21H14.06L25.11,9.94L21.31,6.19H14.06Z"
                                                  Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform"
                                                  Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,6,0,0">
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy View" Click="CopyViewButton_Click"
                            Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Export..." Click="ExportButton_Click"
                            Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click"
                            Style="{StaticResource AccentButton}" Padding="20,8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
