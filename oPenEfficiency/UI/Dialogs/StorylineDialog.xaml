<Window x:Class="oPenEfficiency.UI.Dialogs.StorylineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storyline - Narrative Flow"
        Height="600" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- List Area -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <TextBlock Text="STORYLINE" Style="{StaticResource DialogTitleText}"/>
                    <Button Content="✕" Click="CloseButton_Click" Style="{StaticResource WindowCloseButton}"/>
                </Grid>
                <TextBlock Text="Presentation Narrative Flow" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Click a title to jump to slide. Use the edit icon to update headlines." 
                           Style="{StaticResource DialogSubtitleText}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- List Area -->
            <Border Grid.Row="1" Style="{StaticResource SettingCard}" Padding="0" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0">
                    <ItemsControl x:Name="TitlesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12" Background="Transparent" PreviewMouseLeftButtonDown="Item_Click" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Slide Index Bubble -->
                                        <Border Width="24" Height="24" CornerRadius="12" 
                                                Background="{DynamicResource SurfaceLightBrush}" 
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SlideNumber}" 
                                                       FontSize="11" FontWeight="Bold" 
                                                       Foreground="{DynamicResource AccentBrush}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Title Content (Read-only vs Edit Mode) -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRead" Text="{Binding TitleText}" 
                                                       FontSize="13" TextWrapping="Wrap" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       LineHeight="18" Visibility="Visible"/>
                                            
                                            <TextBox x:Name="TxtEdit" Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" TextWrapping="Wrap" 
                                                     Visibility="Collapsed" 
                                                     Padding="5" 
                                                     KeyDown="TxtEdit_KeyDown"
                                                     LostFocus="TxtEdit_LostFocus"/>
                                        </Grid>

                                        <!-- Edit Action Button -->
                                        <Button Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                                Background="Transparent" BorderThickness="0" Padding="5"
                                                Click="Edit_Click" ToolTip="Edit Title">
                                            <Path Data="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.08L18.92,8.92L20.71,7.13C21.1,6.74 21.1,6.1 20.71,5.71L18.29,2.29C18.1,2.1 17.84,2 17.66,3M14.06,6.19L3,17.25V21H14.06L25.11,9.94L21.31,6.19H14.06Z" 
                                                  Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Button Content="Close" Click="CloseButton_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Padding="20,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy to Clipboard" Click="CopyButton_Click" Style="{StaticResource AccentButton}" Padding="25,8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
