<Window x:Class="oPenEfficiency.UI.SaveToMyAssetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to Favorites"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxHeight="800">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Name -->
                <RowDefinition Height="Auto"/> <!-- 2: Tags -->
                <RowDefinition Height="Auto"/> <!-- 3: Folder Selection Header -->
                <RowDefinition Height="Auto"/> <!-- 4: Folder Tree -->
                <RowDefinition Height="Auto"/> <!-- 5: Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Add to Favorites" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" DockPanel.Dock="Right" />
            </DockPanel>

            <!-- Name Input -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtFileName" FontSize="13" Padding="8,6"
                         Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            </StackPanel>

            <!-- Tags Input -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Tags (separate with commas)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtTags" FontSize="13" Padding="8,6"
                         Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                         Tag="e.g. process, flow, corporate"/>
                <CheckBox x:Name="ChkAutoTag" Content="Auto-generate tags from content" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="True"/>
            </StackPanel>

            <!-- Folder Selection Header -->
            <DockPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="Select Folder" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="BtnNewFolder" Content="📁 New Folder" Padding="8,4" FontSize="11"
                        Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}" Cursor="Hand"
                        Click="BtnNewFolder_Click" DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- Folder Tree -->
            <Border Grid.Row="4" Margin="0,0,0,20" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <TreeView x:Name="FolderTree" MinHeight="150" MaxHeight="300" BorderThickness="0" Background="Transparent" SelectedItemChanged="FolderTree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <TextBlock Text="📁" Margin="0,0,5,0" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" Height="34" Margin="0,0,10,0" Cursor="Hand"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="Save" Style="{StaticResource AccentButton}" Width="100" Height="34" Cursor="Hand"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
