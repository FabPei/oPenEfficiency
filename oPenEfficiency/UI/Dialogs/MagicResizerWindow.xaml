<Window x:Class="oPenEfficiency.UI.MagicResizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Magic Resizer" SizeToContent="Height" MinHeight="350" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0.95"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
                

        

        
        
        <Color x:Key="AccentColor">#3B82F6</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="White"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Border" Width="40" Height="20" CornerRadius="10" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,10,0">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Margin="2"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Anchor Button Style -->
        <Style x:Key="AnchorButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Width="24" Height="24" CornerRadius="4" Background="{DynamicResource SurfaceHoverBrush}" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#555555"/>
                            </Trigger> 
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#005A9E"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Toggle Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger> 
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#444444"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24" Margin="0,0,10,0">
                        <Path Fill="{StaticResource AccentBrush}" Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M11,17H13V15H11V17M11,13H13V11H11V13M11,9H13V7H11V9M7,17H9V15H7V17M7,13H9V11H7V13M7,9H9V7H7V9M15,17H17V15H15V17M15,13H17V11H15V13M15,9H17V7H15V9Z" />
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Magic Resizer" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Intelligently scale objects, fonts, and borders." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12"/>
                </Button>
            </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Loop 1: Dimensions -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="DIMENSIONS" Style="{StaticResource DialogTitleText}" Margin="0,0,0,10"/>

                    <!-- Mode Selection -->
                    <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="4" Padding="2" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RadioPercentage" Content="Percentage" GroupName="Mode" IsChecked="True" Style="{StaticResource TabButtonStyle}" 
                                         HorizontalContentAlignment="Center" Padding="5" Checked="RadioMode_Checked" Cursor="Hand"/>
                            <RadioButton x:Name="RadioAbsolute" Grid.Column="1" Content="Absolute (cm)" GroupName="Mode" Style="{StaticResource TabButtonStyle}" 
                                         HorizontalContentAlignment="Center" Padding="5" Checked="RadioMode_Checked" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Inputs -->
                    <Grid Height="60">
                         <!-- Percentage Mode -->
                        <StackPanel x:Name="PanelPercentage" Visibility="Visible">
                             <TextBlock Text="Scale Factor (%)" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                             <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtPercentage" Text="100" Padding="5"/>
                        </StackPanel>
                        
                         <!-- Absolute Mode -->
                        <StackPanel x:Name="PanelAbsolute" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Width (cm)" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtWidth" Padding="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (cm)" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource InlineTextBoxStyle}" x:Name="TxtHeight" Padding="5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Anchor Point" Margin="0,15,0,5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- Anchor 3x3 Grid -->
                    <UniformGrid Columns="3" Width="84" HorizontalAlignment="Left">
                        <RadioButton GroupName="Anchor" x:Name="AnchorTL" Style="{StaticResource AnchorButtonStyle}"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorTC" Style="{StaticResource AnchorButtonStyle}"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorTR" Style="{StaticResource AnchorButtonStyle}"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorCL" Style="{StaticResource AnchorButtonStyle}"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorCC" Style="{StaticResource AnchorButtonStyle}" IsChecked="True"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorCR" Style="{StaticResource AnchorButtonStyle}"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorBL" Style="{StaticResource AnchorButtonStyle}"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorBC" Style="{StaticResource AnchorButtonStyle}"/>
                        <RadioButton GroupName="Anchor" x:Name="AnchorBR" Style="{StaticResource AnchorButtonStyle}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Col 2: Smart Options -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SMART SCALING" Style="{StaticResource DialogTitleText}" Margin="0,0,0,10"/>

                    <CheckBox x:Name="SwitchFont" Content="Font Size" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <TextBlock Text="Scales text size proportionally" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="50,-5,0,10"/>

                    <CheckBox x:Name="SwitchLine" Content="Line Weight" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <TextBlock Text="Adjusts outline thickness" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="50,-5,0,10"/>

                    <CheckBox x:Name="SwitchMargin" Content="Internal Margins" IsChecked="False" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <TextBlock Text="Scales text box padding" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="50,-5,0,10"/>
                    
                    <CheckBox x:Name="SwitchIndent" Content="Text Indents" IsChecked="False" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <TextBlock Text="Adjusts paragraph indentation" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="50,-5,0,10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button  Content="Resize Objects" Style="{StaticResource AccentButton}" Click="BtnResize_Click" 
                    Padding="20,10" HorizontalAlignment="Right" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
    </Border>
</Window>




