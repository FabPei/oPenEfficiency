<Window x:Class="oPenEfficiency.UI.MagicResizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Selected Shapes" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Compact Task Window, modeless: keep selecting shapes between operations. -->
            <Style x:Key="AnchorButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightStandard}"/>
                <Setter Property="Margin" Value="{StaticResource Space2}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ModeButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightCompact}"/>
                <Setter Property="Margin" Value="{StaticResource Space4}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ScaleOptionStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightStandard}"/>
                <Setter Property="Margin" Value="{StaticResource Space2}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="CompactTaskWindowStyle"/>
    </Window.Style>

    <Border Style="{StaticResource CompactTaskShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MinHeight="{StaticResource ModalHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                    <TextBlock Text="Scale Selected Shapes" Style="{StaticResource DialogTitleText}"
                               TextWrapping="Wrap" Margin="{StaticResource SpaceNone}"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="BtnCancel_Click"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close Scale Selected Shapes"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <TextBlock Text="Scale all selected shapes around the chosen anchor point."
                               Style="{StaticResource ContextMetaText}" Margin="{StaticResource SectionGapCompact}"/>

                    <TextBlock Text="Dimensions" Style="{StaticResource DialogTitleText}"/>
                    <WrapPanel Margin="{StaticResource RelatedControlGap}">
                        <RadioButton x:Name="RadioPercentage" GroupName="Mode" Content="Percentage"
                                     IsChecked="True" Style="{StaticResource ModeButtonStyle}" Checked="RadioMode_Checked"/>
                        <RadioButton x:Name="RadioAbsolute" GroupName="Mode" Content="Absolute (cm)"
                                     Style="{StaticResource ModeButtonStyle}" Checked="RadioMode_Checked"/>
                    </WrapPanel>
                    <Grid Margin="{StaticResource SectionGapCompact}">
                        <StackPanel x:Name="PanelPercentage" Visibility="Visible">
                            <TextBlock Text="Scale factor (%)" Style="{StaticResource ContextMetaText}"
                                       Margin="{StaticResource RelatedControlGap}"/>
                            <TextBox x:Name="TxtPercentage" Text="100" Style="{StaticResource CompactTextBox}"
                                     AutomationProperties.Name="Scale factor in percent"/>
                        </StackPanel>
                        <UniformGrid x:Name="PanelAbsolute" Columns="2" Visibility="Collapsed">
                            <StackPanel Margin="{StaticResource Space4}">
                                <TextBlock Text="Width (cm)" Style="{StaticResource ContextMetaText}"
                                           Margin="{StaticResource RelatedControlGap}"/>
                                <TextBox x:Name="TxtWidth" Style="{StaticResource CompactTextBox}"
                                         AutomationProperties.Name="Reference width in centimeters"/>
                            </StackPanel>
                            <StackPanel Margin="{StaticResource Space4}">
                                <TextBlock Text="Height (cm)" Style="{StaticResource ContextMetaText}"
                                           Margin="{StaticResource RelatedControlGap}"/>
                                <TextBox x:Name="TxtHeight" Style="{StaticResource CompactTextBox}"
                                         AutomationProperties.Name="Reference height in centimeters"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>

                    <TextBlock Text="Anchor point" Style="{StaticResource DialogTitleText}"/>
                    <UniformGrid Columns="3" Margin="{StaticResource SectionGapCompact}">
                        <RadioButton x:Name="AnchorTL" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep top left fixed" AutomationProperties.Name="Anchor at top left">
                            <TextBlock Text="Top left" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorTC" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep top center fixed" AutomationProperties.Name="Anchor at top center">
                            <TextBlock Text="Top center" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorTR" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep top right fixed" AutomationProperties.Name="Anchor at top right">
                            <TextBlock Text="Top right" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorCL" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep middle left fixed" AutomationProperties.Name="Anchor at middle left">
                            <TextBlock Text="Middle left" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorCC" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}" IsChecked="True"
                                     ToolTip="Keep center fixed" AutomationProperties.Name="Anchor at center">
                            <TextBlock Text="Center" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorCR" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep middle right fixed" AutomationProperties.Name="Anchor at middle right">
                            <TextBlock Text="Middle right" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorBL" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep bottom left fixed" AutomationProperties.Name="Anchor at bottom left">
                            <TextBlock Text="Bottom left" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorBC" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep bottom center fixed" AutomationProperties.Name="Anchor at bottom center">
                            <TextBlock Text="Bottom center" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnchorBR" GroupName="Anchor" Style="{StaticResource AnchorButtonStyle}"
                                     ToolTip="Keep bottom right fixed" AutomationProperties.Name="Anchor at bottom right">
                            <TextBlock Text="Bottom right" TextWrapping="Wrap"/>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="Scale with shapes" Style="{StaticResource DialogTitleText}"/>
                    <UniformGrid Columns="2" Margin="{StaticResource RelatedControlGap}">
                        <CheckBox x:Name="SwitchFont" IsChecked="True" Style="{StaticResource ScaleOptionStyle}"
                                  ToolTip="Scale text size proportionally" AutomationProperties.Name="Scale font size">
                            <TextBlock Text="Font size" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="SwitchLine" IsChecked="True" Style="{StaticResource ScaleOptionStyle}"
                                  ToolTip="Scale outline thickness" AutomationProperties.Name="Scale line weight">
                            <TextBlock Text="Line weight" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="SwitchMargin" IsChecked="False" Style="{StaticResource ScaleOptionStyle}"
                                  ToolTip="Scale internal text-frame margins" AutomationProperties.Name="Scale text margins">
                            <TextBlock Text="Text margins" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="SwitchIndent" IsChecked="False" Style="{StaticResource ScaleOptionStyle}"
                                  ToolTip="Scale the relative bullet size" AutomationProperties.Name="Scale bullet size">
                            <TextBlock Text="Bullet size" TextWrapping="Wrap"/>
                        </CheckBox>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="{StaticResource Space4}">
                <Button Content="Scale selection" Style="{StaticResource PrimaryButton}" Click="BtnResize_Click"
                        Margin="{StaticResource Space2}" AutomationProperties.Name="Scale selected shapes"/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"
                        Margin="{StaticResource Space2}"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
