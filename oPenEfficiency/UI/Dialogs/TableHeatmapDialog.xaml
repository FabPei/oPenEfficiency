<Window x:Class="oPenEfficiency.UI.Dialogs.TableHeatmapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Table Heatmap" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style><StaticResource ResourceKey="CompactTaskWindowStyle"/></Window.Style>
    <Border Style="{StaticResource CompactTaskShell}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MinHeight="{StaticResource ModalHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                    <TextBlock Text="TABLE HEATMAP" Style="{StaticResource DialogTitleText}" TextWrapping="Wrap" Margin="{StaticResource SpaceNone}"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="CancelButton_Click"
                        ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel Table Heatmap"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,10,0">
                    <!-- Scope Selection -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Comparison Scope" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <RadioButton x:Name="ScopeRowRadio" GroupName="ComparisonScope" MinHeight="{StaticResource ControlHeightCompact}" Content="Row-wise" IsChecked="True" Checked="Scope_Changed" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="ScopeColRadio" GroupName="ComparisonScope" MinHeight="{StaticResource ControlHeightCompact}" Content="Column-wise" Checked="Scope_Changed" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="ScopeTableRadio" GroupName="ComparisonScope" MinHeight="{StaticResource ControlHeightCompact}" Content="Entire Table" Checked="Scope_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Apply Formatting To -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Apply Formatting To" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <RadioButton x:Name="ApplyFillRadio" GroupName="FormattingTarget" MinHeight="{StaticResource ControlHeightCompact}" Content="Background (Fill)" IsChecked="True" Margin="0,0,16,0" Checked="ApplyType_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="ApplyFontRadio" GroupName="FormattingTarget" MinHeight="{StaticResource ControlHeightCompact}" Content="Font Color" Margin="0,0,16,0" Checked="ApplyType_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="ApplyIconsRadio" GroupName="FormattingTarget" MinHeight="{StaticResource ControlHeightCompact}" Content="Icon Sets" Checked="ApplyType_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Data Handling Options -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Data Handling" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ExcludeHeaderCheckBox" MinHeight="{StaticResource ControlHeightCompact}" IsChecked="True" Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"><TextBlock Text="Exclude top row (header) from calculations" TextWrapping="Wrap"/></CheckBox>
                            <CheckBox x:Name="IgnoreEmptyCheckBox" MinHeight="{StaticResource ControlHeightCompact}" IsChecked="True" Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed" Foreground="{DynamicResource TextPrimaryBrush}"><TextBlock Text="Ignore cells that cannot be evaluated as numbers" TextWrapping="Wrap"/></CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Color Scales and Icons -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Formatting Scheme" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <ComboBox x:Name="ColorPresetsComboBox" AutomationProperties.Name="Heatmap color preset" SelectedIndex="0" Margin="0,0,0,15" SelectionChanged="ColorPresetsComboBox_SelectionChanged">
                                <ComboBoxItem Content="3-Color: Red to Yellow to Green"/>
                                <ComboBoxItem Content="3-Color: Green to Yellow to Red"/>
                                <ComboBoxItem Content="3-Color: Red to White to Green"/>
                                <ComboBoxItem Content="3-Color: Green to White to Red"/>
                                <ComboBoxItem Content="3-Color: Red to White to Blue"/>
                                <ComboBoxItem Content="3-Color: Blue to White to Red"/>
                                <ComboBoxItem Content="2-Color: White to Red"/>
                                <ComboBoxItem Content="2-Color: Red to White"/>
                                <ComboBoxItem Content="2-Color: White to Green"/>
                                <ComboBoxItem Content="2-Color: Green to White"/>
                                <ComboBoxItem Content="2-Color: Yellow to Green"/>
                                <ComboBoxItem Content="2-Color: Green to Yellow"/>
                                <ComboBoxItem Content="Custom..."/>
                            </ComboBox>

                            <ComboBox x:Name="IconPresetsComboBox" AutomationProperties.Name="Heatmap icon preset" SelectedIndex="0" Margin="0,0,0,15" Visibility="Collapsed" SelectionChanged="PreviewOption_Changed">
                                <ComboBoxItem Content="3 Directional Arrows (▲ ▶ ▼)"/>
                                <ComboBoxItem Content="4 Directional Arrows (▲ ↗ ↘ ▼)"/>
                                <ComboBoxItem Content="3 Traffic Lights (● ● ●)"/>
                                <ComboBoxItem Content="3 Indicators (✔ ❗ ✖)"/>
                                <ComboBoxItem Content="3 Ratings (★)"/>
                            </ComboBox>

                            <Grid x:Name="CustomColorPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Lowest Value" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Button x:Name="BtnLowColor" AutomationProperties.Name="Choose lowest value color" Content="Pick Color" Click="BtnLowColor_Click" Style="{StaticResource OutlineButton}" MinHeight="{StaticResource ControlHeightCompact}"/>
                                    <Border x:Name="RectLowColor" Height="10" Margin="0,8,0,0" Background="#F87171" CornerRadius="2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mid Value (Opt.)" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Button x:Name="BtnMidColor" AutomationProperties.Name="Choose middle value color" Content="Pick Color" Click="BtnMidColor_Click" Style="{StaticResource OutlineButton}" MinHeight="{StaticResource ControlHeightCompact}"/>
                                    <Border x:Name="RectMidColor" Height="10" Margin="0,8,0,0" Background="#FBBF24" CornerRadius="2"/>
                                    <Button x:Name="BtnClearMidColor" AutomationProperties.Name="Clear middle value color" Content="Clear" Style="{StaticResource SecondaryButton}" MinHeight="{StaticResource ControlHeightCompact}" Margin="0,4,0,0" Click="BtnClearMidColor_Click" Cursor="Hand"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Highest Value" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Button x:Name="BtnHighColor" AutomationProperties.Name="Choose highest value color" Content="Pick Color" Click="BtnHighColor_Click" Style="{StaticResource OutlineButton}" MinHeight="{StaticResource ControlHeightCompact}"/>
                                    <Border x:Name="RectHighColor" Height="10" Margin="0,8,0,0" Background="#34D399" CornerRadius="2"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Live preview -->
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                        <StackPanel>
                            <TextBlock Text="Preview" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource ContextMetaText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Sample values show the active scheme. Scope, header and empty-cell options apply to the sample exactly as they will to your table."/>
                            <Grid x:Name="PreviewGrid" AutomationProperties.Name="Heatmap preview"/>
                            <TextBlock x:Name="PreviewCaption" Style="{StaticResource ContextMetaText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="{StaticResource Space4}">
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" Margin="{StaticResource Space2}"/>
                <Button x:Name="ApplyButton" Content="Apply Heatmap" Style="{StaticResource PrimaryButton}" Click="ApplyButton_Click" Margin="{StaticResource Space2}"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
