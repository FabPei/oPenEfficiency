<Window x:Class="oPenEfficiency.UI.AlignToTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align to Cell" MinWidth="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="False" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Floating Tool / Palette: repeatable alignment while selecting in PowerPoint. -->
            <Style x:Key="AlignButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Width" Value="{StaticResource ControlHeightStandard}"/>
                <Setter Property="Height" Value="{StaticResource ControlHeightStandard}"/>
                <Setter Property="Margin" Value="{StaticResource Space2}"/>
                <Setter Property="Padding" Value="{StaticResource Space4}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="FloatingPaletteWindowStyle"/>
    </Window.Style>

    <Border Style="{StaticResource FloatingPaletteShell}">
        <StackPanel>
            <Grid MinHeight="{StaticResource FloatingHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown" Padding="{StaticResource Space2}">
                    <TextBlock Text="ALIGN TO CELL" Style="{StaticResource DialogTitleText}"
                               Margin="{StaticResource SpaceNone}" TextWrapping="Wrap"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close Align to Cell"/>
            </Grid>

            <UniformGrid Columns="3" Rows="3" HorizontalAlignment="Center">
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="TOP_LEFT" ToolTip="Align top left" AutomationProperties.Name="Align top left">
                    <Path Data="M0,0 L8,0 L8,1.5 L1.5,1.5 L1.5,8 L0,8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="TOP_CENTER" ToolTip="Align top center" AutomationProperties.Name="Align top center">
                    <Path Data="M0,0 L10,0 L10,1.5 L0,1.5 Z M4,3 L6,3 L6,10 L4,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="TOP_RIGHT" ToolTip="Align top right" AutomationProperties.Name="Align top right">
                    <Path Data="M0,0 L10,0 L10,10 L8.5,10 L8.5,1.5 L0,1.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="MIDDLE_LEFT" ToolTip="Align middle left" AutomationProperties.Name="Align middle left">
                    <Path Data="M0,0 L1.5,0 L1.5,10 L0,10 Z M3,4.25 L10,4.25 L10,5.75 L3,5.75 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="CENTER" ToolTip="Align center" AutomationProperties.Name="Align center">
                    <Rectangle Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="MIDDLE_RIGHT" ToolTip="Align middle right" AutomationProperties.Name="Align middle right">
                    <Path Data="M8.5,0 L10,0 L10,10 L8.5,10 Z M0,4.25 L7,4.25 L7,5.75 L0,5.75 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="BOTTOM_LEFT" ToolTip="Align bottom left" AutomationProperties.Name="Align bottom left">
                    <Path Data="M0,0 L1.5,0 L1.5,8.5 L10,8.5 L10,10 L0,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="BOTTOM_CENTER" ToolTip="Align bottom center" AutomationProperties.Name="Align bottom center">
                    <Path Data="M0,8.5 L10,8.5 L10,10 L0,10 Z M4,0 L6,0 L6,7 L4,7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource AlignButton}" Click="Align_Click" Tag="BOTTOM_RIGHT" ToolTip="Align bottom right" AutomationProperties.Name="Align bottom right">
                    <Path Data="M8.5,0 L10,0 L10,10 L0,10 L0,8.5 L8.5,8.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
