<Window x:Class="oPenEfficiency.UI.Dialogs.GlassHideConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:oPenEfficiency.UI.Controls"
        Title="Glass Settings" Height="320" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style TargetType="Border" x:Key="SettingCard">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
            
            <Geometry x:Key="IconPipette">M19.35,11.72l-2.12,2.12c-0.2,0.2-0.51,0.2-0.71,0l-1.41-1.41c-0.2-0.2-0.2-0.51,0-0.71l2.12-2.12L19.35,11.72z M15.11,12.43l1.41,1.41c0.2,0.2,0.2,0.51,0,0.71l-6.36,6.36c-0.68,0.68-1.57,1.06-2.52,1.06c-1.95,0-3.53-1.58-3.53-3.53c0-0.95,0.38-1.84,1.06-2.52l6.36-6.36c0.2-0.2,0.51-0.2,0.71,0l1.41,1.41c0.2,0.2,0.51,0.2,0.71,0l2.12-2.12c0.2-0.2,0.2-0.51,0-0.71l-2.12-2.12c-0.2-0.2-0.51-0.2-0.71,0l-2.12,2.12c-0.2,0.2-0.2,0.51,0,0.71H9l-2.12-2.12c-0.2-0.2-0.2-0.51,0-0.71L10.41,3.4l2.12,2.12C12.72,5.72,13.03,5.72,13.23,5.52l2.12-2.12c0.2-0.2,0.2-0.51,0-0.71l-2.12-2.12C13.03,0.38,12.72,0.38,12.52,0.58l-2.12,2.12c-0.2,0.2-0.2,0.51,0,0.71L6.17,7.66C5.49,8.34,5.11,9.23,5.11,10.18c0,1.95,1.58,3.53,3.53,3.53c0.95,0,1.84-0.38,2.52-1.06l6.36-6.36c0.2-0.2,0.2-0.51,0-0.71L15.11,12.43z</Geometry>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <controls:FeatureIcon Width="20" Height="20" Margin="0,0,12,0" FeatureId="BtnGlassHide" IconColor="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Glass Overlay Settings" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"/>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1">
                <!-- Transparency -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TRANSPARENCY" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="TextTransparencyVal" Text="50%" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Slider x:Name="SliderTransparency" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderTransparency_ValueChanged"/>
                    </StackPanel>
                </Border>

                <!-- Color -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="OVERLAY COLOR" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextHexColor" Text="#FFFFFF" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="PickColor_Click" Padding="12,0" Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconPipette}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Pick..."/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="0,0,10,0" Padding="20,0" Height="36"/>
                <Button Content="Save &amp; Apply" Style="{StaticResource AccentButton}" Click="Save_Click" Padding="20,0" Height="36"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>