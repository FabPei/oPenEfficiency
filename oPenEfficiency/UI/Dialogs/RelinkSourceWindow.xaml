<Window x:Class="oPenEfficiency.UI.RelinkSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relink Excel Source" Width="590" Height="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource CompactModalWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{DynamicResource CompactModalShell}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="RELINK EXCEL SOURCE" Style="{StaticResource DialogTitleText}"/>
                <Button Style="{StaticResource WindowCloseButton}" Click="Cancel_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="Workbook" Margin="0,18,0,5"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WorkbookPathTextBox" MinHeight="32" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse..." Click="Browse_Click"
                        Style="{StaticResource OutlineButton}" Margin="8,0,0,0"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Worksheet" Margin="0,0,0,5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="WorksheetTextBox" MinHeight="32" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Range" Margin="0,0,0,5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="RangeTextBox" MinHeight="32" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="0,10,0,0"
                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                <Button Content="Relink" Click="Relink_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
