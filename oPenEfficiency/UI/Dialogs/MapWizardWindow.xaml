<Window x:Class="oPenEfficiency.UI.Dialogs.MapWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Builder" Height="720" Width="760" MinHeight="480" MinWidth="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ColorSwatch" TargetType="Button" BasedOn="{StaticResource CompactIconButton}">
                <Setter Property="Margin" Value="{StaticResource Space4}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="LargeWorkspaceWindowStyle"/>
    </Window.Style>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource WorkspaceHeaderHeight}"
                      ResizeBorderThickness="{StaticResource Space4}" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Match the Settings window's compact top/bottom edge gaps (its header margin uses 8);
         left/right keep WorkspaceOuterPadding. -->
    <Border Style="{StaticResource WorkspaceShell}" Padding="20,8,20,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderDragRegion" MinHeight="{StaticResource WorkspaceHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="Transparent">
                    <TextBlock Text="MAP BUILDER" Style="{StaticResource DialogTitleText}"
                               Margin="{StaticResource SpaceNone}" TextWrapping="Wrap"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel Map Builder"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
            <!-- Map catalog -->
            <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="1. Choose a Map" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Text="Map scope:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="CmbMapScope" AutomationProperties.Name="Map scope" Grid.Row="1" Grid.Column="1" SelectionChanged="CmbMapScope_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="World" Tag="World"/>
                        <ComboBoxItem Content="Continent" Tag="Continent"/>
                        <ComboBoxItem Content="Country or territory" Tag="Country"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="Selection:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtWorldSelection" Text="All countries and territories" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="CmbContinent" AutomationProperties.Name="Continent" Visibility="Collapsed" SelectedIndex="2">
                            <ComboBoxItem Content="Africa"/>
                            <ComboBoxItem Content="Asia"/>
                            <ComboBoxItem Content="Europe"/>
                            <ComboBoxItem Content="North America"/>
                            <ComboBoxItem Content="South America"/>
                            <ComboBoxItem Content="Oceania"/>
                            <ComboBoxItem Content="Antarctica"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbCountry" AutomationProperties.Name="Country search" Visibility="Collapsed" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  SelectionChanged="CmbCountry_SelectionChanged"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Detail level:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                        <ComboBox x:Name="CmbDetailLevel" AutomationProperties.Name="Map detail level" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0"
                              SelectionChanged="CmbDetailLevel_SelectionChanged">
                        <ComboBoxItem Content="Country boundaries" Tag="ADM0"/>
                        <ComboBoxItem x:Name="CmbDetailAdmin1" Content="States / provinces" Tag="ADM1"/>
                        <ComboBoxItem x:Name="CmbDetailAdmin2" Content="Second-level regions" Tag="ADM2"/>
                        <ComboBoxItem x:Name="CmbDetailAdmin3" Content="Third-level regions" Tag="ADM3"/>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="Projection:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <ComboBox x:Name="CmbProjection" AutomationProperties.Name="Map projection" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="Mercator (standard)" Tag="Mercator"/>
                        <ComboBoxItem Content="Natural proportions" Tag="Natural"/>
                    </ComboBox>

                    <TextBlock Grid.Row="5" Text="Recent:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <ComboBox x:Name="CmbRecentMaps" AutomationProperties.Name="Recent maps" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"
                              DisplayMemberPath="DisplayName" SelectionChanged="CmbRecentMaps_SelectionChanged"
                              ToolTip="Restore one of the five most recently inserted maps."/>

                    <CheckBox x:Name="ChkLargestLandmassOnly" Grid.Row="6" Grid.Column="1" Content="Use largest landmass only" Margin="0,8,0,0" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtRemoteRegionMode" Grid.Row="6" Text="Remote regions:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="CmbRemoteRegionMode" AutomationProperties.Name="Remote regions" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0" Visibility="Collapsed"
                              ToolTip="Keep remote states or provinces in place, arrange them as compact insets, or omit them from the inserted map.">
                        <ComboBoxItem Content="Keep geographic positions" Tag="Geographic"/>
                        <ComboBoxItem Content="Use compact insets" Tag="CompactInsets"/>
                        <ComboBoxItem Content="Exclude remote regions" Tag="Exclude"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtAdministrativeDistrictState" Grid.Row="6" Text="First-level region:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="CmbAdministrativeDistrictState" AutomationProperties.Name="First-level region" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0" Visibility="Collapsed"
                              ToolTip="Insert every available lower-level region, or only the children of one first-level region."/>

                    <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock x:Name="TxtMapStatus" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="MapInsertProgress" Height="3" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                            <TextBlock Text="Bundled sources: Natural Earth 5.1.1; Germany ADM2/ADM3: BKG via geoBoundaries" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource TypographyCaptionSize}" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button x:Name="BtnInsertMap" Grid.Column="1" Content="Insert Map" Click="BtnInsertMap_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CompactCard}" Height="360">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="2. Paste Region Data" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <!-- Dashed Drop Zone / Paste Area -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1.5" CornerRadius="6" Background="{DynamicResource WindowBackgroundBrush}" Margin="0,0,0,15" Padding="2">
                                
                                <Grid>
                                    <TextBox x:Name="TxtPasteArea" AutomationProperties.Name="Region data to paste" Background="Transparent" BorderThickness="0" AcceptsReturn="True" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="TxtPasteArea_TextChanged"/>
                                    <TextBlock IsHitTestVisible="False" Text="Paste Excel Data Here!&#x0a;Format: Region [TAB] Value" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtPasteArea}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button Grid.Row="2" x:Name="BtnParseData" Content="Parse Data →" Click="BtnParseData_Click" Style="{StaticResource OutlineButton}" MinHeight="{StaticResource ControlHeightCompact}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionGapCompact}" Height="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Data Preview &amp; Matches" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            
                            <DataGrid x:Name="DgDataPreview" AutomationProperties.Name="Region matches preview" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                      Foreground="{DynamicResource TextPrimaryBrush}" RowHeaderWidth="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding RawValue}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="Matched" Binding="{Binding IsMatched}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <TextBlock Text="3. Color Configuration" FontSize="{StaticResource TypographyBodySize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mode:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0"/>
                                <ComboBox x:Name="CmbMode" AutomationProperties.Name="Color mode" Grid.Column="1" SelectionChanged="CmbMode_SelectionChanged">
                                    <ComboBoxItem Content="Continuous (Heatmap)" Tag="Continuous" IsSelected="True"/>
                                    <ComboBoxItem Content="Categorical (Exact Label)" Tag="Categorical"/>
                                </ComboBox>
                            </Grid>

                            <!-- Heatmap Config -->
                            <StackPanel x:Name="SpHeatmap">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Low Value Color:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0" Width="100"/>
                                    <TextBox x:Name="TxtLowColor" AutomationProperties.Name="Low value color code" Grid.Column="1" Text="#E3F2FD" VerticalContentAlignment="Center" Padding="4,2"/>
                                    <Button x:Name="BtnPickLow" Grid.Column="2" Style="{StaticResource ColorSwatch}" Background="#E3F2FD" Click="BtnPickLowColor_Click"
                                            ToolTip="Choose low value color" AutomationProperties.Name="Choose low value color">
                                        <Border Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                                                CornerRadius="{StaticResource RadiusSmall}" BorderThickness="1" BorderBrush="{DynamicResource TextPrimaryBrush}"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="High Value Color:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0" Width="100"/>
                                    <TextBox x:Name="TxtHighColor" AutomationProperties.Name="High value color code" Grid.Column="1" Text="#0D47A1" VerticalContentAlignment="Center" Padding="4,2"/>
                                    <Button x:Name="BtnPickHigh" Grid.Column="2" Style="{StaticResource ColorSwatch}" Background="#0D47A1" Click="BtnPickHighColor_Click"
                                            ToolTip="Choose high value color" AutomationProperties.Name="Choose high value color">
                                        <Border Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                                                CornerRadius="{StaticResource RadiusSmall}" BorderThickness="1" BorderBrush="{DynamicResource TextPrimaryBrush}"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="TxtCategoricalNotice" Text="Category colors are assigned automatically from the data labels." Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" Visibility="Collapsed" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="{StaticResource Space4}">
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"
                            Margin="{StaticResource Space2}"/>
                    <Button x:Name="BtnApply" Content="Apply to Map" Style="{StaticResource PrimaryButton}" Click="BtnApply_Click"
                            Margin="{StaticResource Space2}"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
