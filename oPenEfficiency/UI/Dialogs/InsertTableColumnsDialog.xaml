<Window x:Class="oPenEfficiency.UI.InsertTableColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Multiple Columns" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Small, Segoe UI"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12"
            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock x:Name="DialogTitle" Text="INSERT MULTIPLE COLUMNS" Style="{StaticResource DialogTitleText}"/>
                <Button Style="{StaticResource WindowCloseButton}" Click="Cancel_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="CountLabel" Text="Number of columns (2–50)" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="ColumnCountTextBox" Text="2" Width="90" Height="32"
                         HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                         Style="{StaticResource InlineTextBoxStyle}"
                         PreviewTextInput="NumberValidationTextBox"/>
                <CheckBox x:Name="PreserveWidthCheckBox" Content="Preserve total table width"
                          Margin="0,16,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Insert" Width="90" Height="34" Style="{StaticResource AccentButton}"
                        Click="Insert_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Height="34" Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
