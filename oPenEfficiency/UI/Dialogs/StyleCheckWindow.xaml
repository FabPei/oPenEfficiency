<Window x:Class="oPenEfficiency.UI.StyleCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Style Check" Width="720" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            
            <Style x:Key="TabItemStyle" TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="15,10" Cursor="Hand">
                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="20,20,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="STYLE CHECK" Style="{StaticResource DialogTitleText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Reviewing: " Style="{StaticResource ContextMetaText}"/>
                        <TextBlock x:Name="ScopeSummaryText" Text="Selected slides" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Fix Safe Issues..." Click="FixSafeIssues_Click" Margin="0,0,10,0" Padding="10,4" Style="{StaticResource AccentButton}"/>
                    <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,10,0" Padding="10,4" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="20,0,20,8" Padding="12,8" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Check scope" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ScopeSelector" Width="190" SelectionChanged="ScopeSelector_SelectionChanged">
                        <ComboBoxItem Content="Current Slide"/>
                        <ComboBoxItem Content="Selected Slides"/>
                        <ComboBoxItem Content="Entire Presentation"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,5,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle}"/>
                </TabControl.Resources>
                
                <TabItem Header="ALL ISSUES (BY SLIDE)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,15" Padding="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding BySlide}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SlideName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="SlideName_MouseDown" ToolTip="Click to jump to this slide"/>
                                            <TextBlock Text="Perfectly in target theme - no issues found!" Foreground="#10B981" FontSize="12" Margin="0,0,0,4" Visibility="{Binding IsPerfect, Converter={StaticResource BoolToVis}}"/>
                                            <ItemsControl ItemsSource="{Binding Errors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ErrorType}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                            
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <!-- Color preview if applicable -->
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Value}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" Visibility="{Binding IsColor, Converter={StaticResource BoolToVis}}"/>
                                                                
                                                                <!-- Error value/description -->
                                                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" MaxWidth="230"/>
                                                                
                                                                <!-- Suggested correction preview -->
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding CanAutoCorrect, Converter={StaticResource BoolToVis}}" Margin="10,0,0,0">
                                                                    <TextBlock Text="→" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SuggestedCorrection}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,5,0" Visibility="{Binding IsColor, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="{Binding SuggestedCorrection}" Foreground="#10B981" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Content="Jump" Click="Jump_Click" Tag="{Binding}" Margin="0,0,5,0" Padding="8,2" FontSize="10" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                                                                <Button Content="Auto-Fix" Click="AutoFix_Click" Tag="{Binding}" Visibility="{Binding CanAutoCorrect, Converter={StaticResource BoolToVis}}" Margin="0,0,5,0" Padding="8,2" FontSize="10" Style="{StaticResource AccentButton}"/>
                                                                <Button Content="Ignore Rule" Click="Ignore_Click" Tag="{Binding}" Padding="8,2" FontSize="10" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                
                <TabItem Header="SUMMARY">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,15" Padding="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding SummaryGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                                        <TextBlock Text="{Binding CountText}" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
