<Window x:Class="oPenEfficiency.UI.FormatNumbersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Format Numbers" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Compact Task Window, modeless: options apply to the next grouping action. -->
            <Style x:Key="FormatActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightCompact}"/>
                <Setter Property="Padding" Value="{StaticResource Space6}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Margin" Value="{StaticResource RelatedControlGap}"/>
            </Style>
            <Style x:Key="CurrencyButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="MinWidth" Value="{StaticResource ControlHeightProminent}"/>
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightCompact}"/>
                <Setter Property="Padding" Value="{StaticResource Space4}"/>
                <Setter Property="Margin" Value="{StaticResource Space2}"/>
                <Setter Property="FontSize" Value="{StaticResource TypographyCaptionSize}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>
            <Style x:Key="OptionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource TypographyBodySize}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="{StaticResource RelatedControlGap}"/>
            </Style>
            <Style x:Key="RadioStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightCompact}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="{StaticResource Space4}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="CompactTaskWindowStyle"/>
    </Window.Style>

    <Border Style="{StaticResource CompactTaskShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid MinHeight="{StaticResource ModalHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                    <TextBlock Text="FORMAT NUMBERS" Style="{StaticResource DialogTitleText}"
                               TextWrapping="Wrap" Margin="{StaticResource SpaceNone}"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close Format Numbers"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <TextBlock Text="Set currency options, then choose a grouping preset to apply."
                               Style="{StaticResource ContextMetaText}" Margin="{StaticResource SectionGapCompact}"/>

                    <StackPanel Margin="{StaticResource SectionGapCompact}">
                        <TextBlock Style="{StaticResource OptionHeader}" Text="Currency placement"/>
                        <WrapPanel>
                            <RadioButton x:Name="RadioPrefix" Content="Prefix" GroupName="CurrencyPlacement"
                                         Style="{StaticResource RadioStyle}" IsChecked="True" Checked="Placement_Changed"/>
                            <RadioButton x:Name="RadioSuffix" Content="Suffix" GroupName="CurrencyPlacement"
                                         Style="{StaticResource RadioStyle}" Checked="Placement_Changed"/>
                            <RadioButton x:Name="RadioInPlace" Content="In-place" GroupName="CurrencyPlacement"
                                         Style="{StaticResource RadioStyle}" Checked="Placement_Changed"/>
                            <RadioButton x:Name="RadioRemove" Content="Remove" GroupName="CurrencyPlacement"
                                         Style="{StaticResource RadioStyle}" Checked="Placement_Changed"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtPlacementInfo" Text="Common in English-speaking countries ($100.00)."
                                   Style="{StaticResource ContextMetaText}" Margin="{StaticResource SpaceNone}"/>
                    </StackPanel>

                    <StackPanel Margin="{StaticResource SectionGapCompact}">
                        <TextBlock Style="{StaticResource OptionHeader}" Text="Target currency"/>
                        <TextBox x:Name="TxtCurrency" Style="{StaticResource CompactTextBox}"
                                 AutomationProperties.Name="Target currency symbol" Margin="{StaticResource RelatedControlGap}"/>
                        <WrapPanel>
                            <Button Content="$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol $" AutomationProperties.Name="Use currency symbol $"/>
                            <Button Content="€" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol €" AutomationProperties.Name="Use currency symbol €"/>
                            <Button Content="¥" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol ¥" AutomationProperties.Name="Use currency symbol ¥"/>
                            <Button Content="£" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol £" AutomationProperties.Name="Use currency symbol £"/>
                            <Button Content="A$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol A$" AutomationProperties.Name="Use currency symbol A$"/>
                            <Button Content="C$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol C$" AutomationProperties.Name="Use currency symbol C$"/>
                            <Button Content="Fr" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol Fr" AutomationProperties.Name="Use currency symbol Fr"/>
                            <Button Content="HK$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol HK$" AutomationProperties.Name="Use currency symbol HK$"/>
                            <Button Content="S$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol S$" AutomationProperties.Name="Use currency symbol S$"/>
                            <Button Content="kr" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol kr" AutomationProperties.Name="Use currency symbol kr"/>
                            <Button Content="₩" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol ₩" AutomationProperties.Name="Use currency symbol ₩"/>
                            <Button Content="NZ$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol NZ$" AutomationProperties.Name="Use currency symbol NZ$"/>
                            <Button Content="₹" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol ₹" AutomationProperties.Name="Use currency symbol ₹"/>
                            <Button Content="Mex$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol Mex$" AutomationProperties.Name="Use currency symbol Mex$"/>
                            <Button Content="NT$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol NT$" AutomationProperties.Name="Use currency symbol NT$"/>
                            <Button Content="R" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol R" AutomationProperties.Name="Use currency symbol R"/>
                            <Button Content="R$" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol R$" AutomationProperties.Name="Use currency symbol R$"/>
                            <Button Content="₽" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol ₽" AutomationProperties.Name="Use currency symbol ₽"/>
                            <Button Content="₺" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol ₺" AutomationProperties.Name="Use currency symbol ₺"/>
                            <Button Content="zł" Click="QuickCurrency_Click" Style="{StaticResource CurrencyButton}"
                                    ToolTip="Use currency symbol zł" AutomationProperties.Name="Use currency symbol zł"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource OptionHeader}" Text="Grouping and separators"/>
                    <Button Style="{StaticResource FormatActionButton}" Click="Format_Click" Tag="COMMA"
                            AutomationProperties.Name="Apply comma grouping">
                        <TextBlock TextWrapping="Wrap"><Run Text="Comma grouping" FontWeight="SemiBold"/><Run Text=" (US, UK: 1,234.56)"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FormatActionButton}" Click="Format_Click" Tag="PERIOD"
                            AutomationProperties.Name="Apply period grouping">
                        <TextBlock TextWrapping="Wrap"><Run Text="Period grouping" FontWeight="SemiBold"/><Run Text=" (DE, IT: 1.234,56)"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FormatActionButton}" Click="Format_Click" Tag="SPACE"
                            AutomationProperties.Name="Apply space grouping">
                        <TextBlock TextWrapping="Wrap"><Run Text="Space grouping" FontWeight="SemiBold"/><Run Text=" (FR, SE: 1 234,56)"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FormatActionButton}" Click="Format_Click" Tag="APOSTROPHE"
                            AutomationProperties.Name="Apply apostrophe grouping">
                        <TextBlock TextWrapping="Wrap"><Run Text="Apostrophe grouping" FontWeight="SemiBold"/><Run Text=" (CH, LI: 1'234.56)"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FormatActionButton}" Click="Format_Click" Tag="INDIAN"
                            AutomationProperties.Name="Apply indian numbering">
                        <TextBlock TextWrapping="Wrap"><Run Text="Indian numbering" FontWeight="SemiBold"/><Run Text=" (IN: 1,23,456.78)"/></TextBlock>
                    </Button>
                    <TextBlock Text="Preserves surrounding text and styling."
                               Style="{StaticResource ContextMetaText}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
