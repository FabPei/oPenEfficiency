<Window x:Class="oPenEfficiency.UI.WpfColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Color" Height="380" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseDown="Window_MouseDown"
        FontFamily="Segoe UI Variable Small, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="SELECT COLOR" Style="{StaticResource DialogTitleText}"/>
                <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HexTextBox" Height="34" Padding="8,6" FontSize="14" FontFamily="Consolas" TextChanged="HexTextBox_TextChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="ColorPreview" Grid.Column="1" Width="50" Height="34" Margin="15,0,0,0" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#E53935"/>
                                <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255" Margin="10,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" Foreground="#E53935"/>
                                <TextBlock x:Name="RValue" Grid.Column="2" Text="{Binding Value, ElementName=RSlider}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,15,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="G" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#43A047"/>
                                <Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255" Margin="10,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" Foreground="#43A047"/>
                                <TextBlock x:Name="GValue" Grid.Column="2" Text="{Binding Value, ElementName=GSlider}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,15,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E88E5"/>
                                <Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255" Margin="10,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" Foreground="#1E88E5"/>
                                <TextBlock x:Name="BValue" Grid.Column="2" Text="{Binding Value, ElementName=BSlider}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Width="80" Height="32" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="OK" Width="90" Height="32" Style="{StaticResource AccentButton}" Click="OkButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>