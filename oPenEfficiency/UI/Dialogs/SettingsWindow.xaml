<Window x:Class="oPenEfficiency.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:oPenEfficiency"
        xmlns:controls="clr-namespace:oPenEfficiency.UI.Controls"
        mc:Ignorable="d"
        Title="Settings &amp; Layout Manager"
        Width="1020" Height="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{Binding AppFontFamily, FallbackValue='Segoe UI'}"
        ShowInTaskbar="False"
        Opacity="1.0">
        
    <!-- Custom Window Chrome for drag/resize with AllowsTransparency=True -->
    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="32" 
            ResizeBorderThickness="6" 
            GlassFrameThickness="0" 
            CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:FeatureIconConverter x:Key="IconConverter"/>
            <local:ColorToSolidBrushConverter x:Key="ColorBrushConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Colour swatch button -->
            <Style x:Key="SwatchBtn" TargetType="Button">
                <Setter Property="Width"  Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="bd" CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section label -->
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Margin"     Value="0,12,0,5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Header ─────────────────────────────────────────────── -->
            <DockPanel Margin="0,0,0,20">
                <TextBlock Text="Settings &amp; Layout Manager" FontSize="20" FontWeight="SemiBold"/>
            </DockPanel>

            <!-- ─── Main Workspace: Vertical Layout ─────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="NavListBox" Grid.Column="0" SelectedIndex="0" Background="Transparent" BorderThickness="0" 
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,15,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="Margin" Value="0,2,0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem>General</ListBoxItem>
                    <ListBoxItem>Layout</ListBoxItem>
                    <ListBoxItem>Appearance</ListBoxItem>
                    <ListBoxItem>Stickers &amp; Notes</ListBoxItem>
                    <ListBoxItem>Shortcuts</ListBoxItem>
                    <ListBoxItem>Backup &amp; Config</ListBoxItem>
                    <ListBoxItem>About</ListBoxItem>
                </ListBox>

                <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,10,0"/>

                <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedIndex, ElementName=NavListBox}" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                <!-- ── Tab 0: General ─────────────────────────────────── -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,30,30,30" MaxWidth="700" HorizontalAlignment="Left">
                            <!-- MASTER OBJECT MODE -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Master Object Anchor" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Determines which object acts as the primary anchor for tools like Alignment, Resizing, and Gaps Removal." />
                            </StackPanel>
                            <ComboBox Width="250" HorizontalAlignment="Left" ItemsSource="{Binding AvailableMasterObjectModes}" SelectedItem="{Binding MasterObjectMode}" Margin="0,0,0,20"/>

                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,20,0,20" />

                            <!-- SPACING INCREMENT -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,20">
                                <TextBlock Text="Spacing Increment (pt)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Set the distance applied when using 'Increase/Decrease Spacing' tools." />
                            </StackPanel>
                            <Grid Margin="0,0,0,30" HorizontalAlignment="Left" Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SpacingIncrement, Mode=TwoWay}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="50" Text="{Binding SpacingIncrement, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,5,0" Padding="2"/>
                                    <TextBlock Text="pt" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,20" />

                            <!-- STYLE CHECK SETTINGS -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Style Check Configuration" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Configure acceptable colors and fonts that will be ignored (marked as correct) by the Style Checker." />
                            </StackPanel>
                            
                            <Grid Margin="0,0,0,30" MaxWidth="600">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Correct Colors (Hex Codes, comma separated)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Grid.Row="1" Text="{Binding StyleCheckCorrectColors, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="30" Margin="0,0,0,15" Padding="5" Background="{DynamicResource SurfaceBrush}" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                         
                                <TextBlock Grid.Row="2" Text="Correct Fonts (Font Names, comma separated)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Grid.Row="3" Text="{Binding StyleCheckCorrectFonts, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="30" Margin="0,0,0,0" Padding="5" Background="{DynamicResource SurfaceBrush}" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,30,0,30" />

                            <!-- TRANSLATION SETTINGS -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Translation Settings" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Choose a translation provider and provide your API key. If no key is provided, the native PowerPoint translation pane will be used as a fallback." />
                            </StackPanel>

                            <Grid Margin="0,0,0,30" MaxWidth="600">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="Translation Provider" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableTranslationTools}" SelectedItem="{Binding SelectedTranslationTool}" Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- DeepL Settings -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTranslationTool}" Value="DeepL">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="DeepL API Key (Free or Pro)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding DeepLApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="30" Padding="5" Background="{DynamicResource SurfaceBrush}" 
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>

                                <!-- OpenAI Settings -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTranslationTool}" Value="OpenAI">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="OpenAI API Key" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding OpenAIApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="30" Margin="0,0,0,10" Padding="5" Background="{DynamicResource SurfaceBrush}" 
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    <TextBlock Text="Model" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableOpenAIModels}" SelectedItem="{Binding OpenAIModel}" Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Claude Settings -->
                                <StackPanel Grid.Row="3" Margin="0,0,0,15">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTranslationTool}" Value="Claude">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Claude API Key" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClaudeApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="30" Margin="0,0,0,10" Padding="5" Background="{DynamicResource SurfaceBrush}" 
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    <TextBlock Text="Model" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableClaudeModels}" SelectedItem="{Binding ClaudeModel}" Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- LibreTranslate Settings -->
                                <StackPanel Grid.Row="4" Margin="0,0,0,15">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTranslationTool}" Value="LibreTranslate">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Base URL" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding LibreTranslateBaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="30" Margin="0,0,0,10" Padding="5" Background="{DynamicResource SurfaceBrush}" 
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    <TextBlock Text="API Key (Optional)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding LibreTranslateApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="30" Margin="0,0,0,10" Padding="5" Background="{DynamicResource SurfaceBrush}" 
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="5">
                                    <TextBlock Text="Target Language" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableTargetLanguages}" SelectedValue="{Binding TranslationTargetLanguage}"
                                              Width="200" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,30" />

                            <!-- Cache Management -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="Cache Management" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Thumbnail caches are stored in %APPDATA%\oPenEfficiency\cache\. Clean up stale or legacy cache files to free up disk space." />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CacheSizeText" Text="Cache size: Calculating..." FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Removes stale caches (deleted source files) and legacy adjacent cache folders."
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" x:Name="CleanupCacheBtn" Content="Cache bereinigen"
                                                Click="CleanupCacheBtn_Click"
                                                Width="150" Height="34"
                                                Style="{StaticResource AccentButton}"
                                                HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock x:Name="CacheCleanupResult" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Shared Folders Configuration -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="Shared Folders" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Add shared folder paths (OneDrive, network shares) where local caching should be used. This keeps cache files local to each user instead of cluttering shared directories." />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="1" x:Name="BtnAddSharedFolderSettings" Content="+ Add Shared Folder"
                                                Click="BtnAddSharedFolderSettings_Click"
                                                Width="160" Height="34"
                                                Style="{StaticResource AccentButton}"/>
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource WindowBackgroundBrush}">
                                        <ListBox x:Name="LstSharedFoldersSettings"
                                                 SelectionMode="Single"
                                                 MaxHeight="150"
                                                 Background="Transparent"
                                                 BorderThickness="0"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button x:Name="BtnRemoveSharedFolderSettings" Content="Remove Selected"
                                                Click="BtnRemoveSharedFolderSettings_Click"
                                                Width="130" Height="30"
                                                Style="{StaticResource {x:Type Button}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Tab 1: Layout ──────────────────────────────────── -->
                <TabItem Header="Layout">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ─── Left Pane: Feature Pool ─────────────────────────────── -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Available Features" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="5" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                <TextBlock IsHitTestVisible="False" Text="Search for features..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ListBox x:Name="PoolListBox" Grid.Row="2" ItemsSource="{Binding FilteredPool}" SelectedItem="{Binding SelectedPoolFeature}"
                                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     PreviewMouseLeftButtonDown="PoolListBox_PreviewMouseLeftButtonDown"
                                     MouseMove="PoolListBox_MouseMove">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <controls:FeatureIcon Width="16" Height="16" Margin="0,0,10,0" 
                                                                  FeatureId="{Binding Id}" 
                                                                  IconColor="{Binding Id, Converter={StaticResource IconConverter}, ConverterParameter=Color}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- ─── Right Pane: Sidebar Layout ───────────────────────────── -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                <TextBlock Text="Preset:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}" Width="160" Margin="0,0,8,5" />
                                <Button Content="Apply" Command="{Binding ApplyPresetCommand}" Style="{StaticResource StandardButton}" Padding="10,2" Margin="0,0,15,5"/>
                                
                                <Button Content="Export..." Command="{Binding ExportLayoutOnlyCommand}" Style="{StaticResource StandardButton}" Padding="10,2" Margin="0,0,5,5"/>
                                <Button Content="Import..." Command="{Binding ImportLayoutOnlyCommand}" Style="{StaticResource StandardButton}" Padding="10,2" Margin="0,0,15,5"/>
                                
                                <Button Content="+ Add Section" Command="{Binding AddSectionCommand}" Style="{StaticResource AccentButton}" Padding="10,2" Cursor="Hand" Margin="0,0,0,5"/>
                            </WrapPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,15" Padding="12"
                                                    CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <TextBox x:Name="SectionNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{DynamicResource SurfaceLightBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="5" FontWeight="Bold"/>
                                                            <TextBlock IsHitTestVisible="False" Text="Section Name" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=SectionNameBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Color:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                             <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="70" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,2"/>
                                                            <Button Content="..." ToolTip="Pick Color" Click="PickSectionColor_Click" Background="{DynamicResource SurfaceLightBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="5,0,0,0" Width="24" Height="24" Cursor="Hand" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    VerticalAlignment="Center" Margin="20,0,0,0">
                                                            <CheckBox Content="Visible" IsChecked="{Binding IsVisible}"
                                                                      Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                                              <Button Content="Add Selected"
                                                                    Command="{Binding DataContext.AddFeatureToSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource AccentButton}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Content="✕" ToolTip="Remove Section"
                                                                Command="{Binding DataContext.RemoveSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" Foreground="#E57373"
                                                                BorderThickness="0" FontSize="14" FontWeight="Bold" Margin="15,0,0,0" Cursor="Hand" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ListBox ItemsSource="{Binding Features}"
                                                             AllowDrop="True" Drop="SectionListBox_Drop"
                                                             Background="{DynamicResource SurfaceBrush}" BorderThickness="0" MinHeight="40">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="4,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <controls:FeatureIcon Width="14" Height="14" Margin="0,0,8,0"
                                                                                              FeatureId="{Binding Id}"
                                                                                              IconColor="{Binding DataContext.Color, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColorBrushConverter}, TargetNullValue=#888888, FallbackValue=#888888}"/>
                                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="✕" Click="RemoveFeature_Click"
                                                                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                                                                            BorderThickness="0" Padding="5,0" Cursor="Hand"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ── Tab 2: Appearance ──────────────────────────────── -->
                <TabItem Header="Appearance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,10,20,20" MaxWidth="800" HorizontalAlignment="Left">
                            <StackPanel.Resources>
                                <Style TargetType="Border" x:Key="SettingCard">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Padding" Value="24"/>
                                    <Setter Property="Margin" Value="0,0,0,16"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBlock Text="Sidebar Appearance" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Customize the colors and sizing of your tools to align with your preferences or corporate branding." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,30" TextWrapping="Wrap" LineHeight="20"/>

                            <!-- THEME SELECTION -->
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Application Theme" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Choose between default styles or a custom corporate theme." />
                                    </StackPanel>
                                    <ComboBox Width="250" HorizontalAlignment="Left" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding AppTheme}" Padding="8,4" Margin="0,0,0,20"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Application UI Font" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="Set the font family used for the entire sidebar and dialogs." />
                                    </StackPanel>
                                    <ComboBox Width="250" HorizontalAlignment="Left" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding AppFontFamily}" Padding="8,4">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <Border Style="{StaticResource SettingCard}">
                                        <StackPanel>
                                            <TextBlock Text="Colour Options" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sidebar Background" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,14"/>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                                                    <RadioButton x:Name="RadioBg" IsChecked="True" GroupName="ColorTarget" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ColorTarget_Changed"/>
                                                    <TextBox x:Name="BgHexBox" Width="120" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" TextChanged="BgHexBox_TextChanged" FontFamily="Consolas" FontSize="13"/>
                                                    <Border Width="32" Height="32" Margin="12,0,0,0" CornerRadius="6" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{Binding BackgroundColor}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Section Header Text" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,14"/>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                                                    <RadioButton x:Name="RadioFont" IsChecked="False" GroupName="ColorTarget" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ColorTarget_Changed"/>
                                                    <TextBox x:Name="FontHexBox" Width="120" Text="{Binding SectionFontColor, UpdateSourceTrigger=PropertyChanged}" TextChanged="FontHexBox_TextChanged" FontFamily="Consolas" FontSize="13"/>
                                                    <Border Width="32" Height="32" Margin="12,0,0,0" CornerRadius="6" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{Binding SectionFontColor}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Button Background" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                    <RadioButton x:Name="RadioBtn" IsChecked="False" GroupName="ColorTarget" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ColorTarget_Changed"/>
                                                    <TextBox x:Name="BtnBgHexBox" Width="120" Text="{Binding ButtonBackgroundColor, UpdateSourceTrigger=PropertyChanged}" TextChanged="BtnBgHexBox_TextChanged" FontFamily="Consolas" FontSize="13"/>
                                                    <Border Width="32" Height="32" Margin="12,0,0,0" CornerRadius="6" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{Binding ButtonBackgroundColor}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Sizing Card -->
                                    <Border Style="{StaticResource SettingCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,15">
                                                <TextBlock Text="Typography &amp; Sizing" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FontSizeLabel" Text="{Binding SectionFontSize, StringFormat={}{0:F0} pt}" Foreground="#0078D4" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="16"/>
                                            </DockPanel>

                                            <TextBlock Text="Section Header Font Size" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="7" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Slider Grid.Column="1" x:Name="FontSizeSlider" Minimum="7" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="{Binding SectionFontSize, Mode=TwoWay}" ValueChanged="FontSizeSlider_ValueChanged" Foreground="#0078D4"/>
                                                <TextBlock Grid.Column="2" Text="18" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>

                                            <DockPanel Margin="0,16,0,15">
                                                <TextBlock Text="Button Icon Size" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="IconSizeLabel" Text="{Binding IconSize, StringFormat={}{0:F0} px}" Foreground="#0078D4" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="16"/>
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="8" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Slider Grid.Column="1" x:Name="IconSizeSlider" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="{Binding IconSize, Mode=TwoWay}" Foreground="#0078D4"/>
                                                <TextBlock Grid.Column="2" Text="24" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>

                                            <Button Content="Reset Sidebar Styles to Default"
                                                    Command="{Binding ResetSidebarStylesCommand}"
                                                    HorizontalAlignment="Left" Margin="0,20,0,0" Padding="12,6"
                                                    Background="#607D8B" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Contrast Warning -->
                                    <Border x:Name="ContrastWarningBanner" Margin="0,0,0,16" Padding="14,12" CornerRadius="8" Background="#3a2a00" BorderBrush="#FFB900" BorderThickness="1" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠" FontSize="20" Foreground="#FFB900" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock x:Name="ContrastWarningTitle" FontWeight="Bold" Foreground="#FFB900" FontSize="13" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="ContrastWarningDetail" Foreground="#FFD966" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource SettingCard}" VerticalAlignment="Top" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Live Preview" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <Border x:Name="SidebarPreviewBorder" Width="90" Height="150" CornerRadius="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1.5" Background="{Binding BackgroundColor}">
                                            <StackPanel Margin="8,10">
                                                <TextBlock x:Name="PreviewLabel1" Text="ALIGN" FontSize="8" HorizontalAlignment="Center" Margin="0,0,0,4" Foreground="{Binding SectionFontColor}"/>
                                                <Rectangle Height="1.5" Fill="{DynamicResource BorderLightBrush}" Margin="0,0,0,6"/>
                                                <UniformGrid Columns="4">
                                                    <Border Width="14" Height="14" Margin="1.5" CornerRadius="3" Background="{Binding ButtonBackgroundColor}" BorderBrush="#666" BorderThickness="1"/>
                                                    <Border Width="14" Height="14" Margin="1.5" CornerRadius="3" Background="{Binding ButtonBackgroundColor}" BorderBrush="#666" BorderThickness="1"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource SettingCard}" Padding="20,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,16">
                                        <TextBlock Text="Colour Palettes" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Right" Padding="10,6" CornerRadius="6" Background="#1A1A1A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Applying to: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TargetHint" Text="Background Colour" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                    <WrapPanel x:Name="ThemeSwatchPanel" Margin="0,2,0,12">
                                        <TextBlock x:Name="ThemePlaceholder" Text="(open a presentation to see theme colours)" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" FontSize="11"/>
                                    </WrapPanel>
                                    <TextBlock Text="Windows 11 Accent Colours" Style="{StaticResource GroupLabel}"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Style="{StaticResource SwatchBtn}" Background="#FFB900" Tag="#FFB900" Click="Swatch_Click"/>
                                        <Button Style="{StaticResource SwatchBtn}" Background="#FF8C00" Tag="#FF8C00" Click="Swatch_Click"/>
                                        <Button Style="{StaticResource SwatchBtn}" Background="#0078D4" Tag="#0078D4" Click="Swatch_Click"/>
                                        <Button Style="{StaticResource SwatchBtn}" Background="#00B294" Tag="#00B294" Click="Swatch_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Tab 3: Stickers & Notes ───────────────────────── -->
                <TabItem Header="Stickers &amp; Notes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,30,30,30" MaxWidth="700" HorizontalAlignment="Left">
                            <TextBlock Text="Sticky Note Default Style" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Choose the design that will be inserted when you click the general 'Sticky Note' button." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,30" TextWrapping="Wrap" LineHeight="20"/>

                            <RadioButton x:Name="RbStickyTheme" Content="Standard Theme Pattern" GroupName="StickyStyle" Tag="Theme" Checked="StickyStyle_Checked" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <RadioButton x:Name="RbStickyConsulting" Content="Consulting Yellow" GroupName="StickyStyle" Tag="Consulting" Checked="StickyStyle_Checked" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <RadioButton x:Name="RbStickyGreenB" Content="GreenB (Highlights &amp; Validations)" GroupName="StickyStyle" Tag="GreenB" Checked="StickyStyle_Checked" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Sticky Note Default Text" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,8"/>
                            <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding StickyNoteDefaultText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                            <TextBlock Text="Sticky Note Font" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding StickyNoteFont}" Margin="0,0,0,20"/>

                            <TextBlock Text="Sticky Note Colors" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Background Color" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="120" Text="{Binding StickyNoteBackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="..." Click="PickStickyBgColor_Click" Width="24" Height="24" Margin="5,0,0,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"/>
                                        <Border Width="24" Height="24" Margin="5,0,0,0" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{Binding StickyNoteBackgroundColor}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Font Color" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="120" Text="{Binding StickyNoteFontColor, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="..." Click="PickStickyFontColor_Click" Width="24" Height="24" Margin="5,0,0,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"/>
                                        <Border Width="24" Height="24" Margin="5,0,0,0" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{Binding StickyNoteFontColor}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="Reset to Default Colors" 
                                        Command="{Binding ResetStickyStylesCommand}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,4"
                                        Style="{StaticResource {x:Type Button}}" FontSize="11"/>
                            </Grid>
 
                            <TextBlock Text="Illustrative Sticker Format" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,8"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,30,0" Grid.ColumnSpan="2">
                                    <TextBlock Text="Available Texts (comma-separated)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                                    <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding IllustrativeStickerTexts, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Color (Hex)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                                    <TextBox Width="120" Text="{Binding IllustrativeStickerColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Width="200">
                                    <TextBlock Text="Line Size (pt)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="1" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding IllustrativeStickerLineSize, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" Width="45" Text="{Binding IllustrativeStickerLineSize, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="2"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Tab 4: Shortcuts ───────────────────────────────────── -->
                <TabItem Header="Shortcuts">
                    <Grid Margin="30,30,30,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Keyboard Shortcuts" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="Assign custom keyboard combinations to quickly access your favorite tools without using the mouse." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" LineHeight="20"/>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search Box for Shortcuts -->
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,15" HorizontalAlignment="Left" Width="300">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Grid>
                                        <TextBox x:Name="ShortcutSearchBox" Text="{Binding ShortcutSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" VerticalAlignment="Center" Width="260" FontSize="13"/>
                                        <TextBlock IsHitTestVisible="False" Text="Search shortcuts..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ShortcutSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- List of Shortcuts -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                                <ItemsControl ItemsSource="{Binding FilteredShortcuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="300"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <controls:FeatureIcon Grid.Column="0" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                          FeatureId="{Binding FeatureId}"
                                                                          IconColor="{Binding FeatureId, Converter={StaticResource IconConverter}, ConverterParameter=Color}"/>
                                                    
                                                    <TextBlock Grid.Column="1" Text="{Binding FeatureName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    
                                                    <!-- Shortcut Badge -->
                                                    <Border Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ShortcutText}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                         <Button Content="Clear" Command="{Binding ClearCommand}" VerticalAlignment="Center" Background="#C62828" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="12,4" Margin="0,0,8,0" Cursor="Hand"/>
                                                         <Button Content="Edit Shortcut" Command="{Binding EditCommand}" VerticalAlignment="Center" Style="{StaticResource {x:Type Button}}" Padding="12,4" Cursor="Hand"/>
                                                     </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ── Tab 5: Backup & Config ──────────────────────────── -->
                <TabItem Header="Backup &amp; Config">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,30,30,30" MaxWidth="700" HorizontalAlignment="Left">
                            
                            <TextBlock Text="Configuration Manager" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Share your customized add-in setup with colleagues or back it up. You can choose exactly which parts of your configuration to export or import." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,30" TextWrapping="Wrap" LineHeight="20"/>

                            <!-- Options Card -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Export Options" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                    
                                    <CheckBox Content="Sidebar Layout (Categories &amp; Tools)" IsChecked="{Binding ExportLayout}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <CheckBox Content="Appearance (Colors &amp; Sizing)" IsChecked="{Binding ExportColors}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <CheckBox Content="Sticky Note Default Style" IsChecked="{Binding ExportSticky}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <CheckBox Content="Exclude API Keys (Recommended)" IsChecked="{Binding ExcludeApiKeys}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/>
                                    </StackPanel>                            </Border>

                            <!-- Actions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding ExportCommand}" Cursor="Hand" Height="45" Style="{StaticResource AccentButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⤓" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Export Configuration" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding ImportCommand}" Cursor="Hand" Height="45" Style="{StaticResource {x:Type Button}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⤒" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Import Configuration" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Danger Zone -->
                            <Border Background="#2A1515" BorderBrush="#E57373" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,30,0,0">
                                <StackPanel>
                                    <TextBlock Text="Danger Zone" FontSize="16" FontWeight="SemiBold" Foreground="#E57373" Margin="0,0,0,8"/>
                                    <TextBlock Text="Resetting to defaults will erase all your custom layouts, shortcuts, and appearance settings." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                    <Button Content="Restore All Defaults" Command="{Binding ResetToDefaultsCommand}"
                                            HorizontalAlignment="Left" Padding="15,8"
                                            Background="#E57373" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Tab 6: About ──────────────────────────────────── -->
                <TabItem Header="About">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30,40,30" MaxWidth="800" HorizontalAlignment="Left">
                            <Grid Margin="0,0,0,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="oPenEfficiency" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="A personal open-source productivity toolkit for Microsoft PowerPoint." FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Version 2026.4.25.1435" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" FontFamily="Consolas"/>
                                </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Project Vision" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="oPenEfficiency is an experimental, personal collection of tools designed to streamline common tasks in PowerPoint. It is shared as-is with the open-source community in the hope that it might be useful for others looking to automate their workflows."
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>

                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                                    <TextBlock Text="What's New in this Version" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="• Split Shape: Fixed bug where splitting labels caused an error.&#x0A;• Magic Resizer: Enabled usage for single grouped shapes.&#x0A;• Export Wizard: Single slide PPTX export now correctly saves only the selected slides.&#x0A;• Match Size: Fixed Master option not being respected.&#x0A;• Clone Selection: Added new tool to clone objects perfectly adjacent in all 4 directions.&#x0A;• Smart Eyedropper: Automatically detects and applies color to Fill, Line, or Text."
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>

                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                                    <TextBlock Text="Source Code" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Origin of the Add-in: https://github.com/FabPei/oPenEfficiency"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>

                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                                    <TextBlock Text="Disclaimer" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="This is a hobby project and not a commercial product. It is provided WITHOUT ANY WARRANTY, express or implied. The author assumes no liability for any data loss or issues caused by the use of this software." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap" FontStyle="Italic"/>
                                    </StackPanel>
                                    </Border>
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#1D2E3E" BorderBrush="#264A62" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="License" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Licensed under the GNU GPL 3.0. Free to use, modify, and distribute." Foreground="#90CAF9" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#2E251D" BorderBrush="#624A26" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Development" FontWeight="Bold" Foreground="#FFB74D" Margin="0,0,0,4"/>
                                        <TextBlock Text="Bug reports and suggestions are welcome on the GitHub issues page." Foreground="#FFE0B2" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                </Grid>                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            </Grid>

            <!-- ─── Footer ─────────────────────────────────────────────── -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save &amp; Apply" Command="{Binding SaveCommand}" Width="120" Height="34" Style="{StaticResource AccentButton}" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Command="{Binding CloseCommand}" Width="100" Height="34" Style="{StaticResource {x:Type Button}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
