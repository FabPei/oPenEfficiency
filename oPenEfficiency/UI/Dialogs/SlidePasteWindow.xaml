<Window x:Class="oPenEfficiency.UI.SlidePasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slide Paste"
        Width="600" Height="540"
        MinWidth="480" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown"
        FontFamily="Segoe UI Variable Small, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Border" x:Key="SettingCard">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Header -->
                <RowDefinition Height="Auto"/>   <!-- Options -->
                <RowDefinition Height="*"/>      <!-- Slide grid -->
                <RowDefinition Height="Auto"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="SLIDE PASTE" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="Insert mini-slide references into the current slide." Margin="0,4,0,0" Style="{StaticResource DialogSubtitleText}"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <!-- ── Options ── -->
            <Border Grid.Row="1" Style="{StaticResource SettingCard}" Padding="12,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAddLink"
                              Content="Add hyperlink to slide"
                              IsChecked="True"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalContentAlignment="Center"
                              Margin="0,0,24,0"/>
                    <CheckBox x:Name="ChkAddShadow"
                              Content="Add shadow backdrop"
                              IsChecked="True"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Slide thumbnail grid ── -->
            <Border Grid.Row="2" Style="{StaticResource SettingCard}" Padding="0">
                <Grid>
                    <!-- Loading indicator -->
                    <StackPanel x:Name="LoadingPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Visible">
                        <TextBlock Text="Loading slide thumbnails…"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Slides -->
                    <ScrollViewer x:Name="SlidesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <WrapPanel x:Name="SlidesPanel"
                                   Margin="8"
                                   Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Footer ── -->
            <Grid Grid.Row="3" Margin="0,5,0,0">
                <TextBlock x:Name="TxtStatus"
                           Text="No slides selected"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="90" Height="32"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnClose_Click"
                            Cursor="Hand"/>
                    <Button x:Name="BtnInsert"
                            Content="Insert Selected"
                            Width="130" Height="32"
                            IsEnabled="False"
                            Style="{StaticResource AccentButton}"
                            Click="BtnInsert_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>