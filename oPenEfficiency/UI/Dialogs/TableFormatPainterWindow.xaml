<Window x:Class="oPenEfficiency.UI.TableFormatPainterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Table Format Painter" Height="380" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Table Format Painter" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Paint formats to neighboring cells" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="DIRECTIONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkUp" Content="Up" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ChkDown" Content="Down" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ChkLeft" Content="Left" Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ChkRight" Content="Right" Grid.Column="3" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="FORMAT TARGETS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkText" Content="Text Formatting" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ChkCell" Content="Cell Fill" IsChecked="True" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="ADVANCED" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Skip cells interval:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtSkip" Text="0" Width="50" Margin="10,0,0,0" Padding="5,2" Grid.Column="1" HorizontalContentAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="0,0,10,0" Padding="15,6"/>
            <Button Content="Paint Formats" Style="{StaticResource AccentButton}" Click="BtnOk_Click" Padding="20,6"/>
        </StackPanel>
    </Grid>
</Window>
