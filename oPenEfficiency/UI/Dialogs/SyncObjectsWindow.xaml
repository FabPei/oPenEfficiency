<Window x:Class="oPenEfficiency.UI.SyncObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Shapes Across Slides" Height="520" Width="560" MinHeight="440" MinWidth="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style><StaticResource ResourceKey="LargeWorkspaceWindowStyle"/></Window.Style>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource WorkspaceHeaderHeight}"
                      ResizeBorderThickness="{StaticResource Space4}" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource WorkspaceShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderDragRegion" MinHeight="{StaticResource WorkspaceHeaderHeight}" Margin="{StaticResource RelatedControlGap}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="Transparent">
                    <TextBlock Text="SYNC SHAPES ACROSS SLIDES" Style="{StaticResource DialogTitleText}" TextWrapping="Wrap" Margin="{StaticResource SpaceNone}"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close Sync Shapes Across Slides"/>
            </Grid>
            <TextBlock Grid.Row="1" Style="{StaticResource ContextMetaText}" Margin="{StaticResource RelatedControlGap}"
                       Text="Select target slides and distribute the selected shapes. Then select a tagged copy in PowerPoint to synchronize its properties."/>
            <Border Grid.Row="2" Style="{StaticResource CompactCard}" Padding="{StaticResource SpaceNone}" Margin="{StaticResource RelatedControlGap}">
                <Grid>
                    <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                        <TextBlock Text="Loading slide thumbnails…" Style="{StaticResource ContextMetaText}"/>
                    </StackPanel>
                    <ScrollViewer x:Name="SlidesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed" Focusable="False" AutomationProperties.Name="Target slides">
                        <WrapPanel x:Name="SlidesPanel" Margin="{StaticResource Space4}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <StackPanel Grid.Row="3">
                <Button x:Name="BtnDistribute" Style="{StaticResource PrimaryButton}" Click="BtnDistribute_Click" Margin="{StaticResource RelatedControlGap}">
                    <TextBlock Text="Distribute to Selected Slides" TextWrapping="Wrap"/>
                </Button>
                <TextBlock Text="Synchronize tagged copies" Style="{StaticResource ContextMetaText}" Margin="{StaticResource RelatedControlGap}"/>
                <WrapPanel>
                    <Button x:Name="BtnSyncFormat" Content="Format" Style="{StaticResource SecondaryButton}" Click="BtnSyncFormat_Click"
                            Margin="{StaticResource Space2}" AutomationProperties.Name="Synchronize format"/>
                    <Button x:Name="BtnSyncPosition" Content="Position" Style="{StaticResource SecondaryButton}" Click="BtnSyncPosition_Click"
                            Margin="{StaticResource Space2}" AutomationProperties.Name="Synchronize position"/>
                    <Button x:Name="BtnSyncContent" Content="Content" Style="{StaticResource SecondaryButton}" Click="BtnSyncContent_Click"
                            Margin="{StaticResource Space2}" AutomationProperties.Name="Synchronize content"/>
                </WrapPanel>
                <Grid Margin="{StaticResource Space4}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource ContextMetaText}" Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Button Grid.Column="1" Content="Close" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click" Margin="{StaticResource Space2}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
