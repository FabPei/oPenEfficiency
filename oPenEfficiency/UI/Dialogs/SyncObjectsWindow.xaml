<Window x:Class="oPenEfficiency.UI.SyncObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shape Synchronizer" Height="600" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" 
        WindowStartupLocation="CenterOwner" Topmost="True" MouseDown="Window_MouseDown" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Small, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Border" x:Key="SettingCard">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Info text -->
                <RowDefinition Height="*"/>    <!-- ScrollViewer for slides -->
                <RowDefinition Height="Auto"/> <!-- Distribution controls -->
                <RowDefinition Height="Auto"/> <!-- Sync controls -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="SHAPE SYNCHRONIZER" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="Distribute and sync shapes across slides." Margin="0,4,0,0" Style="{StaticResource DialogSubtitleText}"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            
            <TextBlock Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"
                       Text="1. Select shapes and pick target slides below.&#x0a;2. Click 'Distribute to Slides' to deploy them.&#x0a;3. Modify a deployed shape, select it, and click a Sync button to update its duplicates." />

            <!-- Slide List -->
            <Border Grid.Row="2" Style="{StaticResource SettingCard}" Padding="0">
                <Grid>
                    <!-- Loading indicator -->
                    <StackPanel x:Name="LoadingPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Visible">
                        <TextBlock Text="Loading slide thumbnails…"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Slides -->
                    <ScrollViewer x:Name="SlidesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <WrapPanel x:Name="SlidesPanel"
                                   Margin="8"
                                   Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Distribution Controls -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <Button x:Name="BtnDistribute" Content="Distribute to Selected Slides" Style="{StaticResource AccentButton}" Height="36" Click="BtnDistribute_Click"/>
            </StackPanel>

            <!-- Sync Controls & Footer -->
            <Border Grid.Row="4" Style="{StaticResource SettingCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Synchronize (Requires Tagged Shape Selected):" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="BtnSyncFormat" Grid.Column="0" Content="Format" Style="{StaticResource OutlineButton}" Height="30" Click="BtnSyncFormat_Click"/>
                        <Button x:Name="BtnSyncPosition" Grid.Column="2" Content="Position" Style="{StaticResource OutlineButton}" Height="30" Click="BtnSyncPosition_Click"/>
                        <Button x:Name="BtnSyncContent" Grid.Column="4" Content="Content" Style="{StaticResource OutlineButton}" Height="30" Click="BtnSyncContent_Click"/>
                    </Grid>
                    
                    <Grid Margin="0,15,0,0">
                        <TextBlock x:Name="TxtStatus" Foreground="#10B981" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Width="80" Height="32" HorizontalAlignment="Right" Click="BtnClose_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>