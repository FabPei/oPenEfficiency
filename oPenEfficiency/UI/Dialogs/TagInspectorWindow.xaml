<Window x:Class="oPenEfficiency.UI.Dialogs.TagInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Inspector" Height="500" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseDown="Window_MouseDown"
        FontFamily="Segoe UI Variable Small, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="TAG INSPECTOR" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="View and manage hidden metadata tags." Margin="0,4,0,0" Style="{StaticResource DialogSubtitleText}"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <!-- Scope Selector -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Inspect:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <RadioButton x:Name="RadioSlide" Content="Current Slide" IsChecked="True" Margin="0,0,15,0" Checked="Scope_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <RadioButton x:Name="RadioShapes" Content="Selected Shapes" Margin="0,0,15,0" Checked="Scope_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <RadioButton x:Name="RadioPresentation" Content="Presentation" Checked="Scope_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Tag List -->
            <DataGrid x:Name="TagGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" 
                      Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" 
                      Foreground="{DynamicResource TextPrimaryBrush}" RowBackground="Transparent" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      HeadersVisibility="Column" SelectionMode="Single"
                      CellEditEnding="TagGrid_CellEditEnding">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Convert Sticky Notes to Tags (Slide)" Click="BtnStickyToTags_Click">
                            <MenuItem.Icon>
                                <Path Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M14,17H7V15H14V17M17,13H7V11H17V13M17,9H7V7H17V9Z" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Convert Selected Tag to Sticky Note" Click="BtnTagToSticky_Click">
                            <MenuItem.Icon>
                                <Path Data="M11,9H13V7H11V9M11,17H13V11H11V17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Delete Tag" Click="BtnDelete_Click">
                            <MenuItem.Icon>
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="#EF4444" Stretch="Uniform" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tag Name" Binding="{Binding Name}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" IsReadOnly="False" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
                <Button Content="Delete Selected" Click="BtnDelete_Click" Style="{StaticResource SecondaryButton}" Width="120" Margin="0,0,10,0"/>
                <Button Content="Refresh" Click="BtnRefresh_Click" Style="{StaticResource SecondaryButton}" Width="80"/>
            </StackPanel>

            <!-- Add Tag Section -->
            <Border Grid.Row="4" Margin="0,15,0,0" Padding="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="New Name" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtNewTagName" Style="{StaticResource InlineTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="New Value" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtNewTagValue" Style="{StaticResource InlineTextBoxStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="Add Tag" Click="BtnAdd_Click" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Padding="10,4"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
