<Window x:Class="oPenEfficiency.UI.SaveAgendaLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:oPenEfficiency.UI"
        Title="Agenda Layout Creator" Height="880" Width="750"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" MouseDown="Window_MouseDown" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Section Colors -->
            <SolidColorBrush x:Key="SlideLevelBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="MainItemBrush" Color="#10B981"/>
            <SolidColorBrush x:Key="SubItemBrush" Color="#6B7280"/>
            <SolidColorBrush x:Key="SettingsBrush" Color="#8B5CF6"/>
            <local:ItemSpacingConverter x:Key="ItemSpacingConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header (Draggable Title Bar) -->
            <Grid Grid.Row="0" Margin="0,0,0,15" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AGENDA LAYOUT CREATOR" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="Select a shape in PowerPoint, then click Assign" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontStyle="Italic" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="BtnCancel_Click" />
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,15,0">
                    <!-- Collapsible Info Panel -->
                    <Border x:Name="InfoPanel" Background="{DynamicResource SurfaceLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                        <StackPanel Margin="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="ℹ️" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="HOW TO CREATE A LAYOUT" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnToggleInfo" Content="▼ Info" Width="100" Height="30" Padding="10,2" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnToggleInfo_Click" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel x:Name="InfoContent" Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" LineHeight="18">
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">1. PREPARE:</Run> Place shapes on your PowerPoint slide as you want them to appear in the final agenda<LineBreak/>
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">2. ASSIGN:</Run> Select one shape at a time, click "Assign" for the corresponding field below<LineBreak/>
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">3. BACKGROUND SHAPES:</Run> Are automatically placed BEHIND their text counterparts (create text shape first, then background)<LineBreak/>
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">4. SUB-ITEM FIELDS:</Run> Are optional - if not assigned, the Main Item format will be used for sub-items<LineBreak/>
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">5. MINIMUM REQUIREMENT:</Run> At least "Item Text" must be assigned
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Load Layout Section -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Load Layout:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" x:Name="CboExistingLayouts" Height="32" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LayoutName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Content="Load" Width="80" Height="32" Click="BtnLoadLayout_Click" Style="{StaticResource AccentButton}" Margin="10,0,10,0"/>
                            <Button Grid.Column="3" Content="Clear All" Width="100" Height="32" Click="BtnClearAll_Click" Style="{StaticResource SecondaryButton}" Margin="5,0,10,0"/>
                            <Button Grid.Column="4" x:Name="BtnDeleteLayout" Content="Delete" Width="80" Height="32" Background="#E57373" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Click="BtnDeleteLayout_Click" Margin="5,0,0,0"/>
                            <Button Grid.Column="4" x:Name="BtnDeleteLayoutConfirm" Content="Confirm?" Width="80" Height="32" Background="#C62828" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Visibility="Collapsed" Click="BtnConfirmDeleteLayout_Click" Margin="5,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Slide Level Elements -->
                    <Expander Header="SLIDE LEVEL ELEMENTS (3 fields)" IsExpanded="False" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{StaticResource SlideLevelBrush}" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <StackPanel Margin="10">
                                <!-- Agenda Slide -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" FontWeight="Bold" Foreground="{StaticResource SlideLevelBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Agenda Slide" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ComboBox Grid.Column="2" x:Name="CboSlideStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSlide_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSlide_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Agenda Headline -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" FontWeight="Bold" Foreground="{StaticResource SlideLevelBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Agenda Headline" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ComboBox Grid.Column="2" x:Name="CboHeadlineStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignHeadline_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearHeadline_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Agenda Sub-headline -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" FontWeight="Bold" Foreground="{StaticResource SlideLevelBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Agenda Sub-headline" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ComboBox Grid.Column="2" x:Name="CboSubHeadlineStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSubHeadline_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSubHeadline_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Main Item Elements -->
                    <Expander Header="MAIN ITEM ELEMENTS (6 fields - required core)" IsExpanded="True" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{StaticResource MainItemBrush}" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <StackPanel Margin="10">
                                <!-- Item Numbering -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="{StaticResource MainItemBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Item Numbering" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ComboBox Grid.Column="2" x:Name="CboItemNumberingStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignItemNumbering_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearItemNumbering_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Item Text -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="T" FontWeight="Bold" Foreground="{StaticResource MainItemBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Item Text" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="*" Foreground="#FF5555" FontSize="16" FontWeight="Bold" Margin="3,-2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="CboItemTextStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignItemText_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearItemText_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Item Background -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="B" FontWeight="Bold" Foreground="{StaticResource MainItemBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Item Background" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="(placed behind text)" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="CboItemBackgroundStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignItemBackground_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearItemBackground_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Item Time -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⏰" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Item Time" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" x:Name="CboItemTimeStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignItemTime_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearItemTime_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Item Duration -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⏱" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Item Duration" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="(e.g., 09:00 - 09:15)" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="CboItemDurationStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignItemDuration_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearItemDuration_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Item Responsible -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👤" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Item Responsible" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" x:Name="CboItemResponsibleStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignItemResponsible_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearItemResponsible_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Sub-Item Elements -->
                    <Expander Header="SUB-ITEM ELEMENTS (6 fields - optional)" IsExpanded="False" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{StaticResource SubItemBrush}" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <StackPanel Margin="10">
                                <!-- Sub-Item Numbering -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="{StaticResource SubItemBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Sub-Item Numbering" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ComboBox Grid.Column="2" x:Name="CboSubItemNumberingStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSubItemNumbering_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSubItemNumbering_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Sub-Item Text -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="T" FontWeight="Bold" Foreground="{StaticResource SubItemBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Sub-Item Text" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" x:Name="CboSubItemTextStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSubItemText_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSubItemText_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Sub-Item Background -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="B" FontWeight="Bold" Foreground="{StaticResource SubItemBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Sub-Item Background" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="(uses Item if empty)" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="CboSubItemBackgroundStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSubItemBackground_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSubItemBackground_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Sub-Item Time -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⏰" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Sub-Item Time" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" x:Name="CboSubItemTimeStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSubItemTime_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSubItemTime_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Sub-Item Duration -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⏱" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Sub-Item Duration" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" x:Name="CboSubItemDurationStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSubItemDuration_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSubItemDuration_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                                <!-- Sub-Item Responsible -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👤" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Sub-Item Responsible" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" x:Name="CboSubItemResponsibleStatus" Height="26" Margin="10,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Not Assigned" Tag="0"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Assign" Height="26" Click="BtnAssignSubItemResponsible_Click" Style="{StaticResource SecondaryButton}" Padding="5,2" Margin="0,0,5,0"/>
                                    <Button Grid.Column="4" Content="Clear" Height="26" Click="BtnClearSubItemResponsible_Click" Style="{StaticResource OutlineButton}" Padding="5,2"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Settings Section -->
                    <Expander Header="LAYOUT SETTINGS" IsExpanded="False" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{StaticResource SettingsBrush}" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Layout Name -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Layout Name:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtLayoutName" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <!-- List Alignment -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="List Alignment:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CboListAlignment" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15">
                                <ComboBoxItem Content="Left" IsSelected="True"/>
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Right"/>
                            </ComboBox>

                            <!-- List Orientation -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="List Orientation:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CboListOrientation" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15">
                                <ComboBoxItem Content="Vertical" IsSelected="True"/>
                                <ComboBoxItem Content="Horizontal"/>
                            </ComboBox>

                            <!-- Item Spacing -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Item Spacing (pts):" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Grid Grid.Row="5" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" x:Name="TxtItemSpacing" Height="32" Text="15" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Text>
                                        <Binding ElementName="TxtItemSpacing" Path="Text" Converter="{StaticResource ItemSpacingConverter}" FallbackValue="15 pts | 0.53 cm | 0.21 in"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <!-- Align Middle Option -->
                            <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkAlignMiddle" Content="Align agenda items middle (vertical orientation)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <!-- Align Info Shapes with Item -->
                            <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkAlignInfoShapes" Content="Align info shapes &amp; numbering at same height as item text" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                            <!-- Highlight Options -->
                            <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,15,0,0">
                                <TextBlock Text="Highlight Current Item Text:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkHighlightBold" Content="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,15,5" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkHighlightItalic" Content="Italic" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,15,5" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkHighlightUnderline" Content="Underline" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,15,5" VerticalAlignment="Center"/>
                                    
                                    <!-- Font Color -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                        <CheckBox x:Name="ChkHighlightFontColor" Content="Font Color" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button x:Name="BtnHighlightFontColor" Width="20" Height="20" Click="BtnHighlightFontColor_Click" Cursor="Hand">
                                            <Border x:Name="RectHighlightFontColor" Background="Black" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Fill Color -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                        <CheckBox x:Name="ChkHighlightFillColor" Content="Fill Color" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button x:Name="BtnHighlightFillColor" Width="20" Height="20" Click="BtnHighlightFillColor_Click" Cursor="Hand">
                                            <Border x:Name="RectHighlightFillColor" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        </Button>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="💾 Save Agenda Layout" Style="{StaticResource AccentButton}" Width="180" Height="40" 
                       Click="BtnSave_Click" Margin="0,0,15,0"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="120" Height="40" 
                       Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
