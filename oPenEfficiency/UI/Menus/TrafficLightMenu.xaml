<Window x:Class="oPenEfficiency.UI.TrafficLightMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Light Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{DynamicResource ContextPopupWindowStyle}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Local composition only: preserve shared hit targets while removing popup dead space. -->
            <Style x:Key="TrafficLightStateButton" TargetType="Button"
                   BasedOn="{StaticResource CompactIconButton}">
                <Setter Property="Margin" Value="1,0"/>
            </Style>
            <Style x:Key="TrafficLightOptionButton" TargetType="Button"
                   BasedOn="{StaticResource CompactActionButton}">
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Margin" Value="2,0"/>
            </Style>
            <Style x:Key="TrafficLightSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Fill" Value="{DynamicResource BorderLightBrush}"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Golden Reference: Context Popup / On-click Control. -->
    <Border Style="{DynamicResource ContextPopupShell}">
        <StackPanel Orientation="Horizontal">
            <!-- Traffic-light fills are semantic content colors, not theme chrome. -->
            <Button x:Name="BtnRed" Style="{StaticResource TrafficLightStateButton}"
                    Click="BtnRed_Click" ToolTip="Set to red" AutomationProperties.Name="Set traffic light to red">
                <Ellipse x:Name="IconRed" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Fill="#E83232"/>
            </Button>
            <Button x:Name="BtnYellow" Style="{StaticResource TrafficLightStateButton}"
                    Click="BtnYellow_Click" ToolTip="Set to yellow" AutomationProperties.Name="Set traffic light to yellow">
                <Ellipse x:Name="IconYellow" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Fill="#F5C817"/>
            </Button>
            <Button x:Name="BtnGreen" Style="{StaticResource TrafficLightStateButton}"
                    Click="BtnGreen_Click" ToolTip="Set to green" AutomationProperties.Name="Set traffic light to green">
                <Ellipse x:Name="IconGreen" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Fill="#4CAF3E"/>
            </Button>
            <Button x:Name="BtnOff" Style="{StaticResource TrafficLightStateButton}"
                    Click="BtnOff_Click" ToolTip="Set to off" AutomationProperties.Name="Turn traffic light off">
                <Ellipse x:Name="IconOff" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                         Fill="{DynamicResource SurfaceLightBrush}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
            </Button>

            <Rectangle Style="{StaticResource TrafficLightSeparator}"/>

            <Button x:Name="BtnOrientation" Style="{StaticResource TrafficLightOptionButton}"
                    Click="BtnOrientation_Click" ToolTip="Toggle horizontal or vertical orientation"
                    AutomationProperties.Name="Toggle traffic light orientation">
                <TextBlock x:Name="TxtOrientation" Text="Horiz." FontSize="{StaticResource TypographyCaptionSize}"/>
            </Button>

            <Rectangle Style="{StaticResource TrafficLightSeparator}"/>

            <Button x:Name="BtnBorder" Style="{StaticResource TrafficLightOptionButton}"
                    Click="BtnBorder_Click" ToolTip="Toggle outline frame"
                    AutomationProperties.Name="Toggle traffic light outline frame">
                <TextBlock x:Name="TxtBorder" Text="Frame" FontSize="{StaticResource TypographyCaptionSize}"/>
            </Button>

            <Rectangle Style="{StaticResource TrafficLightSeparator}"/>

            <ComboBox x:Name="ComboWeight" Width="56" MinHeight="{StaticResource ControlHeightCompact}"
                      Margin="2,0" DropDownClosed="ComboWeight_DropDownClosed"
                      VerticalAlignment="Center" ToolTip="Set outline frame weight in points"
                      AutomationProperties.Name="Outline frame weight in points">
                <ComboBoxItem Content="0.5"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="1.5"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
            </ComboBox>
        </StackPanel>
    </Border>
</Window>
