<UserControl x:Class="oPenEfficiency.MainSidebar"
             x:Name="RootSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{DynamicResource SidebarTaskPaneStyle}"
             Background="{DynamicResource SidebarBackgroundBrush}"
             MinWidth="140"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Golden Reference: Sidebar / Task Pane. Native Office chrome owns the outer edge. -->
    <!-- Bind the shell to the root so explicit user custom backgrounds still override the theme token. -->
    <Border Style="{DynamicResource SidebarShell}"
            Background="{Binding Background, ElementName=RootSidebar}">
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Padding="0">
            <StackPanel x:Name="DynamicContentPanel" HorizontalAlignment="Stretch">
                <!-- Built dynamically in RebuildUI() -->
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
