<UserControl x:Class="oPenEfficiency.UI.Panels.GanttChartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:oPenEfficiency.UI.Panels"
             xmlns:models="clr-namespace:oPenEfficiency.Models;assembly=oPenEfficiency.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="400"
             Background="{DynamicResource SurfaceBrush}">
    <UserControl.Resources>
        <local:OutlineLevelToMarginConverter x:Key="OutlineMarginConverter" />
        <local:IsSummaryToFontWeightConverter x:Key="SummaryFontWeightConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <local:IsMilestoneToTypeConverter x:Key="MilestoneTypeConverter" />
        <local:MilestoneShapeToUnicodeConverter x:Key="ShapeToUnicodeConverter" />
        <local:CollapseToggleConverter x:Key="CollapseToggleConverter" />

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ComponentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <!-- Expander Header Style -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <ObjectDataProvider x:Key="MilestoneShapes" MethodName="GetValues" ObjectType="{x:Type models:MilestoneShape}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:MilestoneShape" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="TaskShapes" MethodName="GetValues" ObjectType="{x:Type models:TaskShape}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TaskShape" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: Settings (Grouped with Expanders) -->
        <Border Grid.Column="0" Background="{DynamicResource ComponentBackgroundBrush}" CornerRadius="4" Padding="5" Margin="0,0,5,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Group 1: Project Mode (Primary Settings) -->
                    <Expander IsExpanded="True" Header="Project Mode">
                        <StackPanel Margin="10,5,5,10">
                            <CheckBox IsChecked="{Binding Project.FollowGanttRules}"
                                      Content="Follow Gantt Rules"
                                      ToolTip="Switch between rule-based Gantt scheduling and a flexible roadmap/timeline. Re-enabling recalculates summaries from their children."
                                      FontWeight="Bold" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.AutoFitToSlide}" Content="Auto-fit to Slide" FontWeight="Bold" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.UseManualRange}" Content="Manual Range" ToolTip="Use fixed dates instead of auto-calculating" Margin="0,2"/>
                            <StackPanel IsEnabled="{Binding Project.UseManualRange}" Margin="15,5,0,0">
                                <TextBlock Text="Start:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <DatePicker SelectedDate="{Binding Project.ManualStart}" Margin="0,0,0,5"/>
                                <TextBlock Text="End:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <DatePicker SelectedDate="{Binding Project.ManualEnd}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Group 2: Timeline Scale -->
                    <Expander Header="Timeline Scale">
                        <StackPanel Margin="10,5,5,10">
                            <CheckBox IsChecked="{Binding Project.ShowYears}" Content="Years" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.ShowMonths}" Content="Months" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.ShowWeeks}" Content="Weeks" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.ShowDays}" Content="Days" Margin="0,2"/>
                        </StackPanel>
                    </Expander>

                    <!-- Group 3: Appearance & Styling -->
                    <Expander Header="Appearance &amp; Styling">
                        <StackPanel Margin="10,5,5,10">
                            <CheckBox IsChecked="{Binding Project.ShadeWeekends}" Content="Shade Weekends" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.LockElements}" Content="Lock Elements" ToolTip="Prevent moving individual bars" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.ShowLegend}" Content="Show Legend" Margin="0,2,0,5"/>

                            <TextBlock Text="Theme:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,2"/>
                            <ComboBox SelectedItem="{Binding Project.Theme}" Margin="0,0,0,5">
                                <ComboBoxItem Content="StandardOffice" />
                                <ComboBoxItem Content="HighContrast" />
                                <ComboBoxItem Content="Pastel" />
                            </ComboBox>

                            <TextBlock Text="Font:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,2"/>
                            <ComboBox SelectedValue="{Binding Project.FontFamily}" Margin="0,0,0,5">
                                <ComboBoxItem Content="Segoe UI" />
                                <ComboBoxItem Content="Arial" />
                                <ComboBoxItem Content="Calibri" />
                                <ComboBoxItem Content="Times New Roman" />
                            </ComboBox>
                        </StackPanel>
                    </Expander>

                    <!-- Group 4: Excel Integration -->
                    <Expander Header="Excel Integration">
                        <StackPanel Margin="10,5,5,10">
                            <StackPanel Visibility="{Binding Project.IsLinkedToExcel, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Button Command="{Binding ImportExcelCommand}" Content="Import Excel (One-Time)" Margin="0,2"/>
                                <Button Command="{Binding CreateExcelTemplateCommand}" Content="Create Template" Margin="0,2"/>
                                <Button Command="{Binding ExportToExcelCommand}" Content="Export to Excel" Margin="0,2"/>
                                <Button x:Name="LinkExcelBtn" Content="Link Excel File..." Click="LinkExcelBtn_Click" Margin="0,2"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Project.IsLinkedToExcel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Linked to:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Project.LinkedExcelFilePath}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <Button Command="{Binding SyncExcelCommand}" Content="Sync Now" FontWeight="Bold" Margin="0,2"/>
                                <Button Command="{Binding UnlinkExcelCommand}" Content="Unlink" Margin="0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Group 5: Visible Columns -->
                    <Expander Header="Visible Columns">
                        <StackPanel Margin="10,5,5,10">
                            <CheckBox IsChecked="{Binding Project.ShowNrColumn}" Content="No. (WBS)" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.ShowTaskNameColumn}" Content="Task Name" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding Project.ShowDurationColumn}" Content="Duration" Margin="0,2"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Main Area: Multi-Group Toolbar & DataGrid -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Unified Toolbars -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
                <RowDefinition Height="Auto"/> <!-- Simplified Footer -->
            </Grid.RowDefinitions>

            <!-- Unified Multi-Group Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource ComponentBackgroundBrush}" CornerRadius="4" Padding="5" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Group: Data Editing -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Button Command="{Binding AddTaskCommand}" Content="Add Task" Margin="1" Padding="6,2" ToolTip="Add a task after the selected task and its subtasks"/>
                        <Button Command="{Binding AddMilestoneCommand}" Content="Add Milestone" Margin="1" Padding="6,2" ToolTip="Add a milestone after the selected task and its subtasks"/>
                        <Button Command="{Binding DeleteTaskCommand}" Content="Delete" Margin="1" Padding="6,2" ToolTip="Delete the selected row; subtasks are retained and promoted"/>
                        <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                        <Button Command="{Binding IndentCommand}" Content="→ Indent" Margin="1" Padding="8,2" ToolTip="Increase WBS level when a valid parent exists above"/>
                        <Button Command="{Binding OutdentCommand}" Content="← Outdent" Margin="1" Padding="8,2" ToolTip="Decrease WBS Level"/>
                        <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                        <Button Command="{Binding UndoCommand}" Content="Undo" Margin="1" Padding="6,2"/>
                        <Button Command="{Binding RedoCommand}" Content="Redo" Margin="1" Padding="6,2"/>
                    </StackPanel>

                    <!-- Right Group: Slide Interaction & Tools -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                        <Button Command="{Binding SyncFromSlideCommand}" Content="Sync from Slide" Margin="1" Padding="8,2" Background="{DynamicResource SurfaceHoverBrush}" ToolTip="Reads manual drags from the PowerPoint slide"/>

                        <!-- Shape Import Split-Button Style -->
                        <Menu Background="Transparent" BorderThickness="0" Margin="2,0">
                            <MenuItem Header="Import Tools" Margin="1" Padding="5,2">
                                <MenuItem Command="{Binding AdoptAsTaskCommand}" Header="Adopt Selection as Task" ToolTip="Converts manual PPT shapes into Gantt tasks"/>
                                <MenuItem Command="{Binding AdoptAsMilestoneCommand}" Header="Adopt Selection as Milestone" ToolTip="Converts manual PPT shapes into Gantt milestones"/>
                            </MenuItem>
                        </Menu>

                        <Button x:Name="HelpBtn" Content="?" Click="HelpBtn_Click"
                                Width="26" Height="26" Padding="0" Margin="8,0,0,0"
                                ToolTip="Gantt Chart &amp; Timeline Help" FontWeight="Bold" FontSize="13"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid x:Name="TasksDataGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding VisibleTasks}"
                      SelectedItem="{Binding SelectedTask}"
                      IsReadOnly="{Binding Project.IsLinkedToExcel}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      AllowDrop="True"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseMove="TasksDataGrid_PreviewMouseMove"
                      Drop="TasksDataGrid_Drop"
                      DragOver="TasksDataGrid_DragOver">
                <DataGrid.Resources>
                    <Style TargetType="DatePicker">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Project.IsLinkedToExcel, RelativeSource={RelativeSource AncestorType=local:GanttChartPanel}}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="ComboBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Project.IsLinkedToExcel, RelativeSource={RelativeSource AncestorType=local:GanttChartPanel}}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Width="40" IsReadOnly="True" Binding="{Binding WBS}" />
                    <DataGridTextColumn Header="Type" Width="75" IsReadOnly="True"
                                        Binding="{Binding IsMilestone, Converter={StaticResource MilestoneTypeConverter}}"/>
                    <DataGridTemplateColumn Header="Title" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding OutlineLevel, Converter={StaticResource OutlineMarginConverter}}">
                                    <Button Content="{Binding IsCollapsed, Converter={StaticResource CollapseToggleConverter}}"
                                            Command="{Binding DataContext.ToggleCollapseCommand, RelativeSource={RelativeSource AncestorType=local:GanttChartPanel}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsSummary, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="0,0,3,0" FontSize="9"
                                            VerticalAlignment="Center" Cursor="Hand"/>
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               FontWeight="{Binding IsSummary, Converter={StaticResource SummaryFontWeightConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="{Binding OutlineLevel, Converter={StaticResource OutlineMarginConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Start" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Start, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsSummary, Converter={StaticResource InverseBooleanConverter}}"
                                            BorderThickness="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="End" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding End, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsSummary, Converter={StaticResource InverseBooleanConverter}}"
                                            BorderThickness="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Dur." Width="40" IsReadOnly="True" Binding="{Binding DurationDays}" />
                    <DataGridTextColumn Header="Pred." Width="75" Binding="{Binding PredecessorsString, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTipService.ToolTip="Predecessors — WBS number + optional type + optional lag. Examples: &#10;  2        → 2 FS (finish-to-start, no lag) &#10;  2SS      → 2 start-to-start &#10;  3FF      → 3 finish-to-finish &#10;  2SS+2    → 2 SS with +2-day lag &#10;  3FF-1    → 3 FF with -1-day lead &#10;Separate multiple entries with a comma."/>
                    <DataGridTextColumn Header="%" Width="40" Binding="{Binding PercentComplete, StringFormat=P0}" />
                    <DataGridTemplateColumn Header="T-Shape" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Shape}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsMilestone, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Shape, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding Source={StaticResource TaskShapes}}"
                                          Visibility="{Binding IsMilestone, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="M-Shape" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MilestoneShape, Converter={StaticResource ShapeToUnicodeConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsMilestone, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding MilestoneShape, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding Source={StaticResource MilestoneShapes}}"
                                          Visibility="{Binding IsMilestone, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ShapeToUnicodeConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Simplified Footer: Global Actions & Messaging -->
            <Border Grid.Row="2" Background="{DynamicResource ComponentBackgroundBrush}" CornerRadius="4" Padding="10,5" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Center -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <!-- Gantt rules warning badge -->
                        <Border Background="#C0620F" CornerRadius="3" Padding="7,2" Margin="0,0,10,0"
                                Visibility="{Binding Project.FollowGanttRules, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                ToolTip="This project no longer follows strict Gantt scheduling rules. Summary task dates will not auto-calculate from children.">
                            <TextBlock Text="⚠ Gantt Rules Disabled" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Status:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="Red" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Primary Actions Right -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <CheckBox IsChecked="{Binding IsLivePreviewEnabled}" VerticalAlignment="Center" Content="Live Preview" Margin="0,0,15,0"/>
                        <Button Command="{Binding CreateNewChartCommand}" Content="Create New Chart" Margin="0,0,10,0" Padding="12,5" ToolTip="Insert a new independent Gantt chart or timeline on the current slide"/>
                        <Button Command="{Binding RefreshChartCommand}" Content="Update Active Chart" FontWeight="Bold" Padding="20,5" Background="{DynamicResource HoverBrush}" ToolTip="Rebuild the chart currently loaded in this editor" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Help Overlay -->
        <Grid x:Name="HelpOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="100"
              MouseLeftButtonDown="HelpOverlay_MouseDown">
            <Rectangle Fill="#CC000000" IsHitTestVisible="True"/>
            <Border MaxWidth="700" MaxHeight="540"
                    Margin="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8"
                    MouseLeftButtonDown="HelpCard_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar -->
                    <Border Grid.Row="0" Padding="18,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="?" Foreground="#3B82F6"/><Run Text="  Gantt Chart &amp; Timeline Guide"/>
                            </TextBlock>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CloseHelpBtn_Click" Padding="8,3" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,18">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="H" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                    <Setter Property="Margin" Value="0,14,0,6"/>
                                </Style>
                                <Style x:Key="P" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="18"/>
                                </Style>
                                <Style x:Key="Lbl" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0,4,12,4"/>
                                </Style>
                                <Style x:Key="Dsc" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0,4,0,4"/>
                                </Style>
                                <Style x:Key="Cod" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0,4,12,4"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBlock Style="{StaticResource H}" Text="Getting Started" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource P}" Text="Click Create New Chart to insert a new independent chart or timeline with one starter task. Select an existing chart before opening the editor to continue editing it, then use Update Active Chart to rebuild only that chart."/>

                            <!-- Intro -->
                            <TextBlock Style="{StaticResource H}" Text="What is a Gantt Chart?" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource P}" Text="A Gantt chart visualizes project tasks as horizontal bars along a timeline. It shows when each task starts and ends, how long it lasts, and how tasks depend on one another — making it easy to track progress and spot scheduling conflicts."/>

                            <!-- Chart Areas -->
                            <TextBlock Style="{StaticResource H}" Text="Chart Areas"/>
                            <TextBlock Style="{StaticResource P}" Margin="0,0,0,6"
                                       Text="The chart is split into two panels: a Data Table on the left and a Gantt Timeline on the right. Each visual element in the timeline has a specific meaning."/>

                            <!-- Mini diagram -->
                            <Border Margin="0,4,0,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Header row -->
                                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                                            Background="{DynamicResource ComponentBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Canvas>
                                            <Rectangle Canvas.Left="115" Canvas.Top="0" Width="1" Height="22" Fill="{DynamicResource BorderBrush}"/>
                                            <TextBlock Canvas.Left="4"   Canvas.Top="5" FontSize="7.5" FontWeight="SemiBold" Foreground="#6366F1" Text="Data Table"/>
                                            <TextBlock Canvas.Left="120" Canvas.Top="5" FontSize="7.5" FontWeight="SemiBold" Foreground="#94A3B8" Text="Timeline Header"/>
                                            <TextBlock Canvas.Left="240" Canvas.Top="5" FontSize="7.5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Jan 2025    Feb 2025    Mar 2025"/>
                                        </Canvas>
                                    </Border>

                                    <!-- Data table rows -->
                                    <Border Grid.Row="1" Grid.RowSpan="4" Grid.Column="0"
                                            Background="{DynamicResource ComponentBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                        <StackPanel>
                                            <Border Height="20" Padding="5,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="1  Task A" FontSize="8" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Height="20" Padding="5,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="2  Summary" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Height="20" Padding="14,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="2.1  Subtask" FontSize="8" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Height="20" Padding="5,0">
                                                <TextBlock Text="3  Milestone" FontSize="8" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Gantt Timeline Canvas (rows 1-4 = height 80px) -->
                                    <Canvas Grid.Row="1" Grid.RowSpan="4" Grid.Column="1">

                                        <!-- Weekend shading strips -->
                                        <Rectangle Canvas.Left="78"  Canvas.Top="0" Width="13" Height="80" Fill="#14475569"/>
                                        <Rectangle Canvas.Left="186" Canvas.Top="0" Width="13" Height="80" Fill="#14475569"/>

                                        <!-- Today line -->
                                        <Rectangle Canvas.Left="200" Canvas.Top="0" Width="2" Height="80" Fill="#EF4444"/>

                                        <!-- Task A bar (row 1 in canvas: y=0..20, bar at y=3 h=14) -->
                                        <Rectangle Canvas.Left="10" Canvas.Top="3" Width="140" Height="14" Fill="#3B82F6"/>
                                        <!-- Progress fill ~40% -->
                                        <Rectangle Canvas.Left="10" Canvas.Top="3" Width="56"  Height="14" Fill="#1E40AF"/>

                                        <!-- Summary bar (row 2: y=20..40, thin bar at y=23, tips) -->
                                        <Rectangle Canvas.Left="5" Canvas.Top="23" Width="270" Height="4" Fill="{DynamicResource TextPrimaryBrush}"/>
                                        <Polygon Points="0,0 8,0 4,9" Canvas.Left="5"   Canvas.Top="23" Fill="{DynamicResource TextPrimaryBrush}"/>
                                        <Polygon Points="0,0 8,0 4,9" Canvas.Left="267" Canvas.Top="23" Fill="{DynamicResource TextPrimaryBrush}"/>

                                        <!-- Dependency arrow: Task A end (150,10) → down → right → subtask start -->
                                        <Line X1="150" Y1="10" X2="150" Y2="50" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="2,2"/>
                                        <Line X1="150" Y1="50" X2="158" Y2="50" Stroke="#64748B" StrokeThickness="1"/>
                                        <Polygon Points="0,0 0,6 5,3" Canvas.Left="158" Canvas.Top="47" Fill="#64748B"/>

                                        <!-- Subtask bar (row 3: y=40..60, bar at y=43) -->
                                        <Rectangle Canvas.Left="164" Canvas.Top="43" Width="90" Height="14" Fill="#3B82F6" RadiusX="3" RadiusY="3"/>

                                        <!-- Milestone diamond (row 4: y=60..80, at y=63) -->
                                        <Polygon Points="7,0 14,7 7,14 0,7" Canvas.Left="260" Canvas.Top="63" Fill="#F59E0B"/>

                                    </Canvas>
                                </Grid>
                            </Border>

                            <!-- Diagram legend -->
                            <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap">
                                <Run Foreground="#6366F1" FontWeight="Bold" Text="■ "/>
                                <Run Text="Data Table   "/>
                                <Run Foreground="#94A3B8" FontWeight="Bold" Text="■ "/>
                                <Run Text="Timeline Header   "/>
                                <Run Foreground="#3B82F6" FontWeight="Bold" Text="■ "/>
                                <Run Text="Task Bar (dark = progress)   "/>
                                <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" Text="▼═▼ "/>
                                <Run Text="Summary   "/>
                                <Run Foreground="#F59E0B" FontWeight="Bold" Text="◆ "/>
                                <Run Text="Milestone   "/>
                                <Run Foreground="#EF4444" FontWeight="Bold" Text="| "/>
                                <Run Text="Today   "/>
                                <Run Foreground="#475569" FontWeight="Bold" Text="░ "/>
                                <Run Text="Weekend   "/>
                                <Run Foreground="#64748B" FontWeight="Bold" Text="--→ "/>
