                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#6366F1" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Data Table"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Dsc}" Text="Left panel showing WBS number, task name, and optional duration. Editable — double-click any cell."/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#94A3B8" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Timeline Header"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dsc}" Text="Spans the top of the Gantt area. Shows Year, Month, Week, and/or Day labels based on the Timeline Scale settings in the left panel."/>

                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#3B82F6" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Task Bars"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Dsc}" Text="Colored horizontal bars spanning each task's date range. A darker overlay on the left portion shows completion %."/>

                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="{DynamicResource TextPrimaryBrush}" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Summary Bar"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Dsc}" Text="A thin bar with downward-pointing triangles (▼) at each end, spanning the total date range of all child tasks."/>

                                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#F59E0B" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Milestone Markers"/>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Dsc}" Text="Small shapes placed at the milestone's date. Default is diamond ◆. Style set per row via the M-Shape column."/>

                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#EF4444" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Today Line"/>
                                </StackPanel>
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Dsc}" Text="A vertical red line marking today's date — instantly shows which tasks are past due or running on time."/>

                                <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#475569" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Weekend Shading"/>
                                </StackPanel>
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Dsc}" Text="Light gray vertical bands marking Saturdays and Sundays. Toggle with 'Shade Weekends' in the left panel."/>

                                <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#64748B" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Dependency Arrows"/>
                                </StackPanel>
                                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Dsc}" Text="Lines with arrowheads connecting bars to visualize scheduling order. Drawn from predecessor to successor based on the Pred. column."/>

                                <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,4">
                                    <Border Width="3" Background="#10B981" CornerRadius="1" Margin="0,1,6,1"/>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Legend"/>
                                </StackPanel>
                                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Dsc}" Text="Color-coded key at the bottom of the chart. Toggle with 'Show Legend' in the left panel."/>
                            </Grid>

                            <!-- Task Types -->
                            <TextBlock Style="{StaticResource H}" Text="Task Types"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Task"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Dsc}" Text="A standard work item with a start date, end date, and completion percentage. Shown as a horizontal bar."/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Summary"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dsc}" Text="A parent task that groups child tasks. Its start and end are auto-calculated from its children. Use Indent / Outdent to build hierarchy."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Milestone"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Dsc}" Text="A zero-duration event marking a key date or deliverable. Shown as a symbol (e.g. diamond) on the chart."/>
                            </Grid>

                            <!-- Shape Gallery -->
                            <TextBlock Style="{StaticResource H}" Text="Shape Gallery — How Each Type Looks"/>

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,6" Text="Task Bar Styles (T-Shape)"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Rectangle" VerticalAlignment="Center"/>
                                <Canvas Grid.Row="0" Grid.Column="1" Width="130" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Rectangle Width="130" Height="14" Fill="#3B82F6"/>
                                    <Rectangle Width="52" Height="14" Fill="#1E40AF"/>
                                </Canvas>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Rounded" VerticalAlignment="Center"/>
                                <Canvas Grid.Row="1" Grid.Column="1" Width="130" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Rectangle Width="130" Height="14" Fill="#3B82F6" RadiusX="7" RadiusY="7"/>
                                    <Rectangle Width="52" Height="14" Fill="#1E40AF" RadiusX="7" RadiusY="7"/>
                                </Canvas>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Right Arrow" VerticalAlignment="Center"/>
                                <Canvas Grid.Row="2" Grid.Column="1" Width="130" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Polygon Points="0,4 93,4 93,0 130,7 93,14 93,10 0,10" Fill="#3B82F6"/>
                                </Canvas>

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Chevron" VerticalAlignment="Center"/>
                                <Canvas Grid.Row="3" Grid.Column="1" Width="130" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Polygon Points="14,0 116,0 130,7 116,14 14,14 0,7" Fill="#3B82F6"/>
                                </Canvas>

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="Pentagon" VerticalAlignment="Center"/>
                                <Canvas Grid.Row="4" Grid.Column="1" Width="130" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Polygon Points="0,0 116,0 130,7 116,14 0,14" Fill="#3B82F6"/>
                                </Canvas>
                            </Grid>

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,6" Text="Summary Bar"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Summary" VerticalAlignment="Center"/>
                                <Canvas Grid.Row="0" Grid.Column="1" Width="130" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="130" Height="5" Fill="{DynamicResource TextPrimaryBrush}"/>
                                    <Polygon Points="0,0 8,0 4,10" Fill="{DynamicResource TextPrimaryBrush}" Canvas.Left="0" Canvas.Top="0"/>
                                    <Polygon Points="0,0 8,0 4,10" Fill="{DynamicResource TextPrimaryBrush}" Canvas.Left="122" Canvas.Top="0"/>
                                </Canvas>
                            </Grid>

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,6" Text="Milestone Shapes (M-Shape)"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <StackPanel Margin="0,0,22,0">
                                    <Canvas Width="16" Height="16" HorizontalAlignment="Center">
                                        <Polygon Points="8,0 16,8 8,16 0,8" Fill="#F59E0B"/>
                                    </Canvas>
                                    <TextBlock Text="Diamond" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,22,0">
                                    <Ellipse Width="14" Height="14" Fill="#F59E0B" HorizontalAlignment="Center" Margin="0,1"/>
                                    <TextBlock Text="Circle" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="★" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,-1"/>
                                    <TextBlock Text="Star" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,22,0">
                                    <Canvas Width="16" Height="14" HorizontalAlignment="Center">
                                        <Polygon Points="8,0 16,14 0,14" Fill="#F59E0B"/>
                                    </Canvas>
                                    <TextBlock Text="Triangle" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <Rectangle Width="14" Height="14" Fill="#F59E0B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Square" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Style="{StaticResource H}" Text="Resize Task Bars"/>
                            <TextBlock Style="{StaticResource P}"
                                       Text="Select a regular task bar in the chart to show handles at its left and right edges. Drag the left handle to change the task start, or drag the right handle to change the task end. Summary tasks, milestones, event lines, and Excel-linked charts are calculated or controlled elsewhere and do not show resize handles."/>

                            <!-- Column Reference -->
                            <TextBlock Style="{StaticResource H}" Text="Column Reference"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="No."/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Dsc}" Text="WBS number (e.g. 1, 1.1, 1.2.3). Auto-assigned based on task hierarchy."/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Type"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dsc}" Text="Shows whether the row is a Task or Milestone."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Title"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Dsc}" Text="The name of the task or milestone."/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Start / End"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Dsc}" Text="Working-day date range. Summary task dates are calculated automatically from children."/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="Dur."/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Dsc}" Text="Duration in working days. The end date is the exclusive boundary, so Friday to Monday equals one working day. Read-only — driven by the dates."/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Lbl}" Text="Pred."/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Dsc}" Text="Predecessors. Which tasks must finish or start before this one. See the full explanation below."/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Lbl}" Text="%"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Dsc}" Text="Completion percentage (0–100%). Rendered as a fill inside the task bar."/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Lbl}" Text="T-Shape"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Dsc}" Text="Visual bar style for tasks (Rectangle, Rounded, Arrow, etc.)."/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Lbl}" Text="M-Shape"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Dsc}" Text="Visual symbol for milestones (Diamond ◆, Circle ●, Star ★, Triangle ▲, Square ■)."/>
                            </Grid>

                            <!-- Predecessors -->
                            <TextBlock Style="{StaticResource H}" Text="Predecessors (Pred.) — Scheduling Dependencies"/>
                            <TextBlock Style="{StaticResource P}" Margin="0,0,0,8"
                                       Text="The Pred. column controls which tasks must finish or start before this task is scheduled. Chain multiple dependencies by separating them with a comma."/>
                            <Border Background="{DynamicResource ComponentBackgroundBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Format:  "/>
                                    <Run Foreground="#60A5FA" Text="[WBS]  [Type]  [+/- Lag]"/>
                                    <LineBreak/>
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Example: "/>
                                    <Run Foreground="#60A5FA" Text="2FS+3"/>
                                    <Run Text="   →  start 3 working days after task #2 ends"/>
                                </TextBlock>
                            </Border>

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" Text="Dependency Types"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Cod}" Text="FS"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Dsc}">
                                    <Run FontWeight="Bold" Text="Finish-to-Start"/>
                                    <Run Text=" (default) — this task starts after the predecessor finishes. Write "/>
                                    <Run FontFamily="Consolas" Foreground="#60A5FA" Text="2"/>
                                    <Run Text=" or "/>
                                    <Run FontFamily="Consolas" Foreground="#60A5FA" Text="2FS"/>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Cod}" Text="SS"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dsc}">
                                    <Run FontWeight="Bold" Text="Start-to-Start"/>
                                    <Run Text=" — this task starts when the predecessor starts. Write "/>
                                    <Run FontFamily="Consolas" Foreground="#60A5FA" Text="3SS"/>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Cod}" Text="FF"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Dsc}">
                                    <Run FontWeight="Bold" Text="Finish-to-Finish"/>
                                    <Run Text=" — this task ends when the predecessor ends. Write "/>
                                    <Run FontFamily="Consolas" Foreground="#60A5FA" Text="4FF"/>
                                </TextBlock>
                            </Grid>

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,4" Text="Lag &amp; Lead"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Cod}" Text="+n"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Dsc}" Text="Lag — adds n working days of wait time after the dependency condition is met."/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Cod}" Text="-n"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dsc}" Text="Lead — allows n working days of overlap, so this task can start before the predecessor finishes."/>
                            </Grid>

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,4" Text="Examples"/>
                            <Border Background="{DynamicResource ComponentBackgroundBrush}" CornerRadius="4" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Cod}" Text="2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Dsc}" Text="Starts the day after task #2 finishes (FS, no lag)"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Cod}" Text="2FS+3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dsc}" Text="Starts 3 working days after task #2 ends"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Cod}" Text="3SS"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Dsc}" Text="Starts on the same day as task #3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Cod}" Text="4FF-1"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Dsc}" Text="Ends 1 working day before task #4 ends (lead)"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Cod}" Text="1,3SS"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Dsc}" Text="Depends on both: task #1 (FS) and task #3 (SS) — separate with comma"/>
                                </Grid>
                            </Border>

                            <!-- WBS -->
                            <TextBlock Style="{StaticResource H}" Text="WBS Numbering"/>
                            <TextBlock Style="{StaticResource P}" Text="WBS (Work Breakdown Structure) numbers are auto-assigned based on hierarchy. Top-level tasks get 1, 2, 3… Children get 1.1, 1.2… Grandchildren get 1.1.1, 1.1.2… Use → Indent and ← Outdent in the toolbar to change a task's hierarchy level."/>

                            <!-- Gantt Rules -->
                            <TextBlock Style="{StaticResource H}" Text="Gantt Rules Mode"/>
                            <TextBlock Style="{StaticResource P}" Margin="0,0,0,20" Text="When enabled, scheduling is automatic: summary task dates are calculated from their children, predecessor definitions drive start/end dates, and the dependency network determines the critical path. Disabling it switches to a free-form roadmap layout where you control positions manually. You can re-enable the rules at any time; summaries are then recalculated from their children."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
