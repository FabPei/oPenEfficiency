<Window x:Class="oPenEfficiency.UI.Toolbars.DiagonalAlignToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagonal Align" 
        Height="310" Width="300"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        AllowsTransparency="True" 
        Background="{DynamicResource SurfaceBrush}"
        Topmost="True" 
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Diagonal Align" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <Button Style="{DynamicResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Close"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="Anchor Point" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ComboBox x:Name="CmbAnchor" Grid.Row="2" Margin="0,0,0,15" SelectionChanged="CmbAnchor_SelectionChanged">
            <ComboBoxItem Content="Center (Average)" Tag="Center" IsSelected="True" />
            <ComboBoxItem Content="First Shape (Top/Left-most)" Tag="First" />
            <ComboBoxItem Content="Last Shape (Bottom/Right-most)" Tag="Last" />
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Angle (Degrees)" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="AngleSlider" Minimum="-180" Maximum="180" Value="45" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,15,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
            <TextBox x:Name="AngleTextBox" Grid.Column="1" Text="45" TextChanged="TextBox_TextChanged" TextAlignment="Center" Padding="4"/>
        </Grid>
        
        <UniformGrid Grid.Row="5" Columns="4" Margin="0,0,0,15">
            <Button Content="45°" Margin="0,0,4,0" Style="{DynamicResource StandardButton}" Click="BtnPreset_Click" Tag="45"/>
            <Button Content="135°" Margin="0,0,4,0" Style="{DynamicResource StandardButton}" Click="BtnPreset_Click" Tag="135"/>
            <Button Content="-45°" Margin="0,0,4,0" Style="{DynamicResource StandardButton}" Click="BtnPreset_Click" Tag="-45"/>
            <Button Content="-135°" Margin="0,0,0,0" Style="{DynamicResource StandardButton}" Click="BtnPreset_Click" Tag="-135"/>
        </UniformGrid>

        <TextBlock Grid.Row="6" Text="Spacing between centers (pt)" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Grid.Row="7" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="SpacingSlider" Minimum="0" Maximum="500" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,15,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
            <TextBox x:Name="SpacingTextBox" Grid.Column="1" Text="50" TextChanged="TextBox_TextChanged" TextAlignment="Center" Padding="4"/>
        </Grid>
    </Grid>
</Window>