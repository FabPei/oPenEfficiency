<Window x:Class="oPenEfficiency.UI.ProgressSeriesToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progress Series" 
        Height="50" Width="520"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource WindowBackgroundBrush}"
        Topmost="True" ShowInTaskbar="False"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Theme Colors -->
        <SolidColorBrush x:Key="ThemePrimary" Color="#E53935"/>
        <SolidColorBrush x:Key="ThemeSecondary" Color="#0078D4"/>
        <SolidColorBrush x:Key="ThemeSuccess" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ThemeWarning" Color="#FF9800"/>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                                    Background="{DynamicResource SurfaceLightBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Left" 
                                                VerticalAlignment="Center" 
                                                Margin="4,2"/>
                            </Border>
                            <ToggleButton Grid.Column="1"
                                          Background="{DynamicResource SurfaceLightBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="1,0,1,1"
                                          Width="20"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <Path x:Name="Arrow"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                            </ToggleButton>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"                
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource SurfaceLightBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderBrush}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        
        <StackPanel Orientation="Horizontal" Margin="10,6">
            <!-- Count -->
            <TextBlock Text="Count:" Margin="0,0,4,0"/>
            <TextBox x:Name="TxtCount" Width="30" Text="5" TextAlignment="Center" KeyDown="Input_KeyDown" LostFocus="Input_LostFocus"/>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

            <!-- Active Value -->
            <TextBlock Text="Active:" Margin="0,0,4,0"/>
            <TextBox x:Name="TxtActive" Width="25" Text="3" TextAlignment="Center" Background="Transparent" BorderThickness="0" IsReadOnly="True"/>
            <Slider x:Name="SliderActive" Width="80" Minimum="1" Maximum="5" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="SliderActive_ValueChanged"/>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

            <!-- Shape -->
            <ComboBox x:Name="CmbShape" Width="75" SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="■ Square" IsSelected="True" Tag="Square"/>
                <ComboBoxItem Content="● Circle" Tag="Circle"/>
                <ComboBoxItem Content="◆ Diamond" Tag="Diamond"/>
                <ComboBoxItem Content="▲ Triangle" Tag="Triangle"/>
                <ComboBoxItem Content="★ Star" Tag="Star"/>
                <ComboBoxItem Content="✓ Check" Tag="Check"/>
                <ComboBoxItem Content="✕ Cross" Tag="Cross"/>
                <ComboBoxItem Content="● Dot" Tag="Dot"/>
            </ComboBox>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

            <!-- Mode -->
            <ComboBox x:Name="CmbMode" Width="70" SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="1, 2, 3" IsSelected="True" Tag="Numbers"/>
                <ComboBoxItem Content="A, B, C" Tag="Letters"/>
                <ComboBoxItem Content="a, b, c" Tag="SmallLetters"/>
                <ComboBoxItem Content="I, II, III" Tag="Roman"/>
                <ComboBoxItem Content="i, ii, iii" Tag="SmallRoman"/>
                <ComboBoxItem Content="• Bullets" Tag="Bullets"/>
            </ComboBox>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

            <!-- Orientation -->
            <Button x:Name="BtnOrientation" Click="BtnOrientation_Click">
                <TextBlock x:Name="TxtOrientation" Text="↔" FontSize="12"/>
            </Button>

            <!-- Color -->
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <Button x:Name="BtnColor1" Width="16" Height="16" Background="#E53935" Click="Color_Click" Tag="#E53935" Margin="0,0,2,0"/>
                <Button x:Name="BtnColor2" Width="16" Height="16" Background="#0078D4" Click="Color_Click" Tag="#0078D4" Margin="0,0,2,0"/>
                <Button x:Name="BtnColor3" Width="16" Height="16" Background="#4CAF50" Click="Color_Click" Tag="#4CAF50" Margin="0,0,2,0"/>
                <Button x:Name="BtnColor4" Width="16" Height="16" Background="#FF9800" Click="Color_Click" Tag="#FF9800" Margin="0,0,2,0"/>
                <Button x:Name="BtnColor5" Width="16" Height="16" Background="#9C27B0" Click="Color_Click" Tag="#9C27B0" Margin="0,0,2,0"/>
            </StackPanel>

            <!-- Reset -->
            <Button Content="Reset" Click="BtnReset_Click" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0"/>
        </StackPanel>
    </Border>
</Window>
