<Window x:Class="oPenEfficiency.UI.ProgressSeriesToolbarSimple"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progress Series" 
        Height="40" Width="400"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource WindowBackgroundBrush}"
        Topmost="True" ShowInTaskbar="False"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        
        <StackPanel Orientation="Horizontal" Margin="8,4">
            <!-- Count -->
            <TextBlock Text="Count:" Margin="0,0,4,0"/>
            <TextBox x:Name="TxtCount" Width="30" Text="5" TextAlignment="Center" KeyDown="Input_KeyDown" LostFocus="Input_LostFocus"/>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

            <!-- Active Value -->
            <TextBlock Text="Active:" Margin="0,0,4,0"/>
            <TextBox x:Name="TxtActive" Width="30" Text="3" TextAlignment="Center" Background="Transparent" BorderThickness="0" IsReadOnly="True"/>
            <Slider x:Name="SliderActive" Width="80" Minimum="1" Maximum="5" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="SliderActive_ValueChanged"/>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

            <!-- Shape -->
            <ComboBox x:Name="CmbShape" Width="70" SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="Square" IsSelected="True" Tag="Square"/>
                <ComboBoxItem Content="Circle" Tag="Circle"/>
                <ComboBoxItem Content="Diamond" Tag="Diamond"/>
            </ComboBox>

            <!-- Mode -->
            <ComboBox x:Name="CmbMode" Width="60" SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="Numbers" IsSelected="True" Tag="Numbers"/>
                <ComboBoxItem Content="Letters" Tag="Letters"/>
            </ComboBox>

            <!-- Orientation -->
            <Button x:Name="BtnOrientation" Click="BtnOrientation_Click">
                <TextBlock x:Name="TxtOrientation" Text="↔"/>
            </Button>

            <!-- Color -->
            <Button x:Name="BtnColorWell" Width="20" Height="20" Background="#0078D4" Click="BtnColorWell_Click" Margin="4,0"/>

            <!-- Reset -->
            <Button Content="Reset" Click="BtnReset_Click" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0"/>
        </StackPanel>
    </Border>
</Window>
