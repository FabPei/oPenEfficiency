<Window x:Class="oPenEfficiency.UI.RatingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Rating" 
        Height="42" Width="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/oPenEfficiency;component/UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Color x:Key="StarGold">#FFC107</Color>
        <SolidColorBrush x:Key="StarGoldBrush" Color="{StaticResource StarGold}"/>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="28" Height="14" CornerRadius="7" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.25" Color="#000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource StarGoldBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource WindowBackgroundBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.2" Color="#000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldSlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track -->
                            <Border Height="2" CornerRadius="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                            <!-- Gold Progress Track -->
                            <Canvas ClipToBounds="True" VerticalAlignment="Center">
                                <Border x:Name="PART_SelectionRange" Height="2" CornerRadius="1" Background="{StaticResource StarGoldBrush}" VerticalAlignment="Center"/>
                            </Canvas>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" Cursor="Hand"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="2"/>
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main Pill Shape -->
    <Border CornerRadius="18" Padding="10,0" VerticalAlignment="Center">
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource WindowBackgroundColor}"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.3" BlurRadius="8" ShadowDepth="2" Direction="270"/>
        </Border.Effect>
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource BorderColor}"/>
        </Border.BorderBrush>
        <Border.BorderThickness>
            <Thickness>1</Thickness>
        </Border.BorderThickness>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="32">

            <!-- Star Count Input -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Number of Stars">
                <TextBlock Text="★" Foreground="{StaticResource StarGoldBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Border Width="24" Height="22" CornerRadius="4" Background="{DynamicResource SurfaceLightBrush}" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBox x:Name="TxtStarCount" Text="5" Style="{StaticResource MinimalTextBox}" 
                             LostFocus="TxtStarCount_LostFocus" KeyDown="TxtStarCount_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="2,0"/>

            <!-- Rating Slider -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <TextBlock x:Name="TxtRatingValue" Text="3.0" FontFamily="Segoe UI" FontSize="10" 
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" 
                           Width="24" TextAlignment="Center" Margin="0,0,4,0"/>
                <Slider x:Name="SliderRating" Width="80" Minimum="0" Maximum="5" Value="3" 
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Style="{StaticResource GoldSlider}" VerticalAlignment="Center"
                        ValueChanged="SliderRating_ValueChanged"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="2,0"/>

            <!-- Icon Selector -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <ComboBox x:Name="CmbIcon" Width="68" FontSize="9" SelectedIndex="0" 
                          SelectionChanged="CmbIcon_SelectionChanged" ToolTip="Rating Shape">
                    <ComboBoxItem Content="★ Star"/>
                    <ComboBoxItem Content="● Circle"/>
                    <ComboBoxItem Content="◆ Diamond"/>
                </ComboBox>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="2,0"/>

            <!-- Frame Toggle -->
            <CheckBox x:Name="ChkFrame" Style="{StaticResource ToggleSwitch}" IsChecked="False" 
                      VerticalAlignment="Center" Margin="2,0" ToolTip="Outline Frame"
                      Checked="ChkFrame_Changed" Unchecked="ChkFrame_Changed">
                <Path Data="M4,4H20V20H4V4M6,6V18H18V6H6Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="10" Height="10"/>
            </CheckBox>

            <!-- Separator -->
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="2,0"/>

            <!-- Color Picker Well -->
            <Button x:Name="BtnColorWell" Style="{StaticResource ColorSwatch}" Background="{StaticResource StarGoldBrush}" 
                    Width="20" Height="20" Margin="2,0" Click="BtnColorWell_Click" ToolTip="Change Color"/>

            <!-- Color Popup -->
            <Popup x:Name="ColorPopup" StaysOpen="False" Placement="Mouse" HorizontalOffset="-70" VerticalOffset="10">
                <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" Opacity="0.8" BlurRadius="6" ShadowDepth="2"/>
                    </Border.Effect>
                    <WrapPanel x:Name="ColorPalette" Width="120" Height="44"/>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</Window>
