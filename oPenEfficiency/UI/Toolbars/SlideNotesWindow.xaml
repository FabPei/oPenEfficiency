<Window x:Class="oPenEfficiency.UI.Toolbars.SlideNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Review Notes"
        Height="440" Width="380"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Variable Small, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="{StaticResource CompactWindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="PRIVATE REVIEW NOTES" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="Notes are visible in openEfficiency only." Margin="0,4,0,0" Style="{StaticResource ContextMetaText}"/>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClose_Click" ToolTip="Close"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock x:Name="CommentListHeader" Text="COMMENTS ON THIS SLIDE" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <Button DockPanel.Dock="Right" Content="+ Add" Click="AddCommentButton_Click" Style="{StaticResource AccentButton}" Padding="8,2"/>
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="CommentListBox" Height="86" Margin="0,0,0,6" DisplayMemberPath="Summary"
                         SelectionChanged="CommentListBox_SelectionChanged" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MetadataText" Style="{StaticResource ContextMetaText}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ComboBox Grid.Column="1" x:Name="StatusComboBox" Width="76" Margin="6,0,0,0" SelectionChanged="StatusComboBox_SelectionChanged">
                        <ComboBoxItem Content="Open"/><ComboBoxItem Content="Done"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Attach" Margin="6,0,0,0" Padding="7,2" Click="AttachButton_Click" ToolTip="Attach to the selected shape"/>
                </Grid>
                <TextBox Grid.Row="3" x:Name="NotesTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                         Style="{StaticResource InlineTextBoxStyle}" VerticalContentAlignment="Top"
                         Padding="10" FontSize="13" TextChanged="NotesTextBox_TextChanged"/>
                <DockPanel Grid.Row="4" Margin="0,8,0,0">
                    <Button Content="Delete" Click="DeleteCommentButton_Click" Padding="8,2"/>
                    <Button x:Name="ShowOverlayButton" Content="Show on slide" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="ShowOverlayButton_Click"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
