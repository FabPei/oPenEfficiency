<Window x:Class="oPenEfficiency.UI.Toolbars.GanttToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gantt Styling"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{DynamicResource FloatingPaletteWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Golden Reference: Floating Tool / Palette. The compact header is the only drag surface. -->
    <Border Style="{DynamicResource FloatingPaletteShell}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="Transparent" Padding="0,0,4,0"
                    MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                <TextBlock x:Name="TxtStyleHeader" Text="Task style:" VerticalAlignment="Center"
                           FontSize="{StaticResource TypographyCaptionSize}"
                           FontWeight="SemiBold"/>
            </Border>

            <ComboBox x:Name="CmbShape" Grid.Column="1" Width="104"
                      Style="{DynamicResource CompactComboBox}" Margin="0,0,4,0"
                      SelectionChanged="CmbShape_SelectionChanged"
                      AutomationProperties.Name="Gantt shape style"
                      ToolTip="Choose the task or milestone shape style"/>

            <Button Grid.Column="2" Click="BtnReset_Click" Content="Reset"
                    Style="{DynamicResource CompactActionButton}" Padding="6,2"
                    Margin="0,0,4,0" ToolTip="Reset the Gantt shape style"
                    AutomationProperties.Name="Reset Gantt style"/>

            <Button Grid.Column="3" Style="{DynamicResource WindowCloseButton}"
                    Width="{StaticResource IconButtonSizeCompact}"
                    Height="{StaticResource IconButtonSizeCompact}"
                    Click="BtnClose_Click" VerticalAlignment="Center"
                    ToolTip="Close"
                    AutomationProperties.Name="Close Gantt styling toolbar"/>
        </Grid>
    </Border>
</Window>
