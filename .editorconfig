# oPenEfficiency EditorConfig
# Enforces consistent coding style across all contributors
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
indent_style = space
indent_size = 4

# C# indentation
[{*.cs,*.csx}]
indent_size = 4

# C# style preferences
[*.cs]
# var usage - prefer implicit typing when type is obvious
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true

# Newline preferences
csharp_style_new_line_before_open_brace_type = same_line
csharp_style_new_line_before_open_brace_method = same_line
csharp_style_new_line_before_open_brace_property = same_line
csharp_style_new_line_before_open_brace_event = same_line
csharp_style_new_line_before_open_brace_other = same_line
csharp_style_new_line_before_catch = false
csharp_style_new_line_before_else = false
csharp_style_new_line_before_finally = false

# This. preferences
csharp_style_this_qualifier = false

# Modifier preferences
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async
csharp_style_prefer_async_main = false

# New line preferences
csharp_style_throw_expression = true
csharp_style_conditional_delegate_call = true

# Code-block preferences
csharp_prefer_braces = true
csharp_prefer_simple_using_statement = false

# Namespace preferences
csharp_style_namespace_declarations = file_scoped
csharp_style_pre_globalization_invariant_mode = false

# File-scoped namespaces (C# 10+)
csharp_style_file_scoped_namespace = true

# Expression-level preferences
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_style_prefer_switch_expression = true
csharp_style_prefer_conditional_expression_over_assignment = true
csharp_style_prefer_conditional_expression_over_return = true
csharp_style_deconstructed_variable_declaration = false
csharp_style_prefer_index_operator = true
csharp_style_prefer_range_operator = true

# Null-checking preferences
csharp_style_pattern_like_null_checks = true
csharp_style_prefer_not_pattern_for_null_checks = false

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_constructors = false
csharp_style_expression_bodied_operators = when_on_single_line
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_indexers = true
csharp_style_expression_bodied_accessors = true

# Matching parentheses
csharp_style_match_first_arm_independent_of_discard_presence = true

# Out variable preferences
csharp_style_prefer_inferred_variable_names = true
csharp_style_prefer_inferred_tuple_names = true

# Collection preferences
csharp_style_prefer_collection_expression = false

# Interpolated string preferences
csharp_style_prefer_interpolated_string = true

# Lambda preferences
csharp_style_prefer_simple_lambda = true

# Lock statement preferences
csharp_style_lock_statement = true

# Primary constructor preferences
csharp_style_prefer_primary_constructors = false

# Nullable preferences
csharp_style_null_checking_strategy = skipping

# String preferences
csharp_style_utf8_string_literals = true

# Unused variable preferences
csharp_style_unused_value_expression_statement_preference = discard_variable
csharp_style_unused_value_assignment_preference = discard_variable

# Symbol naming
csharp_style_prefer_top_level_statements = true

# Accessibility modifiers
dotnet_code_quality_unused_parameters = all
dotnet_style_require_accessibility_modifiers = always
dotnet_style_readonly_field = true

# Property naming
dotnet_naming_rule.private_fields_underscore = private_underscore_rule

# Private instance fields should start with underscore
dotnet_naming_symbols.private_underscore_rule.applicable_kinds = field
dotnet_naming_symbols.private_underscore_rule.applicable_accessibilities = private
dotnet_naming_style.private_underscore_style.required_prefix = _
dotnet_naming_style.private_underscore_style.required_suffix =
dotnet_naming_style.private_underscore_style.word_separator = _
